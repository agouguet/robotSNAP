  PluginText: "<gazebo reference=\"cliff_sensor_front_link\">\n  <sensor name=\"cliff_sensor_front\"
    type=\"ray\">\n    <always_on>true</always_on>\n    <update_rate>50</update_rate>\n   
    <visualize>true</visualize>\n    <ray>\n      <scan>\n        <horizontal>\n         
    <samples>50</samples>\n          <resolution>1.0</resolution>\n          <min_angle>-0.0436</min_angle>\n         
    <!-- -2.5 degree -->\n          <max_angle>0.0436</max_angle>\n          <!--
    2.5 degree -->\n        </horizontal>\n        <!-- \\t          Can't use vertical
    rays until this bug is resolved: -->\n        <!--            https://bitbucket.org/osrf/gazebo/issue/509/vertical-sensor-doesnt-works
    -->\n        <!-- \\t          <vertical> -->\n        <!-- \\t            <samples>50</samples>
    -->\n        <!-- \\t            <resolution>1.0</resolution> -->\n        <!--
    \\t            <min_angle>-0.0436</min_angle>  -2.5 degree -->\n        <!--
    \\t            <max_angle>0.0436</max_angle> 2.5 degree -->\n        <!-- \\t         
    </vertical> -->\n      </scan>\n      <range>\n        <min>0.01</min>\n       
    <max>0.15</max>\n        <resolution>1.0</resolution>\n      </range>\n    </ray>\n 
    </sensor>\n</gazebo>"
--- !u!114 &5385607479001327009
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5571857437444155727}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.Robotics.UrdfImporter::Unity.Robotics.UrdfImporter.UrdfPlugin
  PluginText: "<gazebo reference=\"gyro_link\">\n  <sensor name=\"imu\" type=\"imu\">\n   
    <always_on>true</always_on>\n    <update_rate>50</update_rate>\n    <visualize>false</visualize>\n   
    <imu>\n      <noise>\n        <type>gaussian</type>\n        <rate>\n         
    <mean>0.0</mean>\n          <stddev>1.96e-06</stddev>\n          <!-- 0.25 x
    0.25 (deg/s) -->\n          <bias_mean>0.0</bias_mean>\n          <bias_stddev>0.0</bias_stddev>\n       
    </rate>\n        <accel>\n          <!-- not used in the plugin and real robot,
    hence using tutorial values -->\n          <mean>0.0</mean>\n          <stddev>1.7e-2</stddev>\n         
    <bias_mean>0.1</bias_mean>\n          <bias_stddev>0.001</bias_stddev>\n       
    </accel>\n      </noise>\n    </imu>\n  </sensor>\n</gazebo>"
