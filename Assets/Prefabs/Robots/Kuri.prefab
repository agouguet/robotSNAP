  PluginText: "<gazebo reference=\"cliff_sensor_right_link\">\n  <sensor name=\"cliff_sensor_right\"
    type=\"ray\">\n    <always_on>true</always_on>\n    <update_rate>50</update_rate>\n   
    <visualize>true</visualize>\n    <ray>\n      <scan>\n        <horizontal>\n         
    <samples>50</samples>\n          <resolution>1.0</resolution>\n          <min_angle>-0.0436</min_angle>\n         
    <!-- -2.5 degree -->\n          <max_angle>0.0436</max_angle>\n          <!--
    2.5 degree -->\n        </horizontal>\n        <!--            Can't use vertical
    rays until this bug is resolved: -->\n        <!--            https://bitbucket.org/osrf/gazebo/issue/509/vertical-sensor-doesnt-works
    -->\n        <!-- \\t          <vertical> -->\n        <!-- \\t            <samples>50</samples>
    -->\n        <!-- \\t            <resolution>1.0</resolution> -->\n        <!--
    \\t            <min_angle>-0.0436</min_angle>  -2.5 degree -->\n        <!--
    \\t            <max_angle>0.0436</max_angle> 2.5 degree -->\n        <!-- \\t         
    </vertical> -->\n      </scan>\n      <range>\n        <min>0.01</min>\n       
    <max>0.15</max>\n        <resolution>1.0</resolution>\n      </range>\n    </ray>\n 
    </sensor>\n</gazebo>"
--- !u!114 &5070851431238007321
