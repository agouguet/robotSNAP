--- !u!114 &1168696420473021873
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 667660908278635121}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.Robotics.UrdfImporter::Unity.Robotics.UrdfImporter.UrdfPlugin
  PluginText: "<gazebo>\n  <plugin name=\"diff_drive_controller\" filename=\"libgazebo_ros_diff_drive.so\">\n   
    <commandTopic>/swd_diff_drive_controller/cmd_vel</commandTopic>\n    <odometryTopic>/swd_diff_drive_controller/odom</odometryTopic>\n   
    <odometryFrame>odom</odometryFrame>\n    <odometrySource>world</odometrySource>\n   
    <publishOdomTF>true</publishOdomTF>\n    <robotBaseFrame>base_link</robotBaseFrame>\n   
    <publishWheelTF>false</publishWheelTF>\n    <publishTf>true</publishTf>\n   
    <publishWheelJointState>true</publishWheelJointState>\n    <legacyMode>false</legacyMode>\n   
    <updateRate>30</updateRate>\n    <leftJoint>base_swd_left_joint</leftJoint>\n   
    <rightJoint>base_swd_right_joint</rightJoint>\n    <wheelSeparation>0.485</wheelSeparation>\n   
    <wheelDiameter>0.125</wheelDiameter>\n    <wheelAcceleration>11</wheelAcceleration>\n   
    <wheelTorque>37</wheelTorque>\n    <rosDebugLevel>na</rosDebugLevel>\n  </plugin>\n</gazebo>"
--- !u!114 &4299900752130989116
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 667660908278635121}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.Robotics.UrdfImporter::Unity.Robotics.UrdfImporter.UrdfPlugin
  PluginText: "<gazebo reference=\"lidar_link\">\n  <material>Gazebo/FlatBlack</material>\n 
    <sensor type=\"ray\" name=\"lidar_sensor\">\n    <pose>0 0 0 0 0 0</pose>\n   
    <visualize>true</visualize>\n    <update_rate>30</update_rate>\n    <ray>\n     
    <scan>\n        <horizontal>\n          <samples>1080</samples>\n          <resolution>1</resolution>\n         
    <min_angle>-2.356194496154785</min_angle>\n          <max_angle>2.356194496154785</max_angle>\n       
    </horizontal>\n      </scan>\n      <range>\n        <min>0.09</min>\n       
    <max>20</max>\n        <resolution>0.001</resolution>\n      </range>\n     
    <noise>\n        <type>gaussian</type>\n        <mean>0.0</mean>\n        <stddev>0.01</stddev>\n     
    </noise>\n    </ray>\n    <plugin name=\"laser_controller\" filename=\"libgazebo_ros_laser.so\">\n     
    <topicName>scan</topicName>\n      <frameName>lidar_link</frameName>\n    </plugin>\n 
    </sensor>\n</gazebo>"
