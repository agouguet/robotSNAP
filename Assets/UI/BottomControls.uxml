<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="BottomControls" class="panel bottom-controls" style="flex-grow: 1; align-items: stretch;">
        <ui:VisualElement class="timing-group">
            <ui:Label text="Temps simu. :" class="control-label"/>
            <ui:Label text="00:02:45" name="SimTime" class="control-value"/>
        </ui:VisualElement>
        <ui:VisualElement class="timing-group">
            <ui:Label text="Vitesse :" class="control-label"/>
            <ui:Label text="0.45 m/s" name="SpeedValue" class="control-value"/>
        </ui:VisualElement>
        <ui:VisualElement class="timing-group">
            <ui:Label text="Étape :" class="control-label"/>
            <ui:Label text="245 / 1200" name="StepValue" class="control-value"/>
        </ui:VisualElement>
        <ui:Slider name="SpeedSlider" low-value="0" high-value="2" value="1" class="speed-slider" style="justify-content: center; align-items: center;"/>
        <ui:Label text="× 1.0" name="SpeedFactor" class="speed-factor"/>
        <ui:Button text="Pause" name="PauseButton" class="control-button"/>
        <ui:Button text="Arrêter" name="StopButton" class="control-button"/>
    </ui:VisualElement>
</ui:UXML>
