* {
    --bg-primary: rgb(231, 234, 236);
    --bg-secondary: rgb(255, 255, 255);
    --sidebar-bg: rgb(255, 255, 255);
    --panel-bg: rgba(255, 255, 255, 0.92);
    --card-bg: rgb(255, 255, 255);
    --text-primary: rgb(15, 23, 42);
    --text-secondary: rgb(71, 85, 105);
    --text-secondary-muted: rgb(100, 116, 139);
    --accent: rgb(37, 99, 235);
    --accent-soft: rgb(59, 130, 246);
    --accent-glow: rgba(37, 99, 235, 0.15);
    --border-color: rgb(226, 232, 240);
    --button-bg: rgb(241, 245, 249);
    --button-hover: rgb(199, 204, 211);
    --title-corner-bg: rgb(255, 255, 255);
    --title-corner-color: rgb(37, 99, 235);
    --dropdown-bg: rgb(255, 255, 255);
    --dropdown-text: rgb(15, 23, 42);
    --icon-tint: rgb(22, 26, 31);
}

.dark-mode * {
    --bg-primary: rgb(11, 17, 32);
    --bg-secondary: rgb(30, 41, 59);
    --sidebar-bg: rgb(15, 23, 42);
    --panel-bg: rgba(30, 41, 59, 0.85);
    --card-bg: rgb(30, 41, 59);
    --text-primary: rgb(241, 245, 249);
    --text-secondary: rgb(148, 163, 184);
    --text-secondary-muted: rgb(100, 116, 139);
    --accent: rgb(59, 130, 246);
    --accent-soft: rgb(96, 165, 250);
    --accent-glow: rgba(59, 130, 246, 0.2);
    --border-color: rgb(51, 65, 85);
    --button-bg: rgb(51, 65, 85);
    --button-hover: rgb(71, 85, 105);
    --title-corner-bg: rgb(30, 41, 59);
    --title-corner-color: rgb(96, 165, 250);
    --dropdown-bg: rgb(30, 41, 59);
    --dropdown-text: rgb(241, 245, 249);
    --icon-tint: rgb(241, 245, 249);
}

/* ===== GLOBAL ROOT ===== */
.root {
    background-color: var(--bg-primary);
    background-size: cover;
}

.root,
#MainContainer,
#MainContent,
.main-container,
.main-content {
    height: 100%;
    width: 100%;
}

.main-container {
    background-color: var(--bg-primary);
    flex-direction: column;
}

.main-row {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

.main-content {
    flex-grow: 1;
    height: 100%;
    min-height: 0;
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0);
}

/* ===== STATUS BAR ===== */
.status-bar {
    background-color: var(--bg-secondary);
    /* border-top: 1px solid var(--border-color); */
    height: 28px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 0 16px;
}

.status-message {
    font-size: 12px;
    color: var(--text-secondary);
    flex-grow: 1;
}

.status-time {
    font-size: 12px;
    color: var(--text-secondary);
    margin-left: 16px;
}

/* ===== GENERIC ELEMENTS ===== */
.unity-label {
    color: var(--text-primary);
    font-size: 12px;
}

.unity-panel {
    background-color: var(--panel-bg);
    border-width: 1px;
    border-color: var(--border-color);
    border-radius: 4px;
    padding: 8px;
    margin: 4px;
}

.unity-button {
    background-color: var(--button-bg);
    border-width: 0;
    border-radius: 4px;
    padding: 6px 12px;
    color: var(--text-primary);
}

.unity-button:hover {
    background-color: var(--button-hover);
}

.button-icon {
    width: 28px;
    height: 28px;
    margin-right: 8px;
    background-size: contain;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--icon-tint);
}

.button-label {
    color: var(--text-primary);
    font-size: 14px;
}

.button-accent {
    background-color: var(--accent);
    color: rgb(255, 255, 255);
}

.top-bar {
    padding: 12px 16px;
}

.simulator-title {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--text-primary);
}

.simulator-desc {
    font-size: 16px;
    color: var(--text-secondary);
    margin-top: 4px;
}

.view-selector {
    flex-direction: row;
    margin-top: 12px;
}

.simulation-view {
    background-color: var(--bg-secondary);
    border-radius: 6px;
    margin: 8px;
    padding: 8px;
}

.render-zone {
    background-color: rgb(0, 0, 0);
    min-height: 300px;
    border-radius: 4px;
}

.simulation-status {
    margin-top: 12px;
    padding: 8px;
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 4px;
}

.metrics-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 8px;
}

.metric-card {
    flex-grow: 1;
    margin: 4px;
    padding: 8px;
    background-color: var(--card-bg);
    border-width: 1px;
    border-color: var(--border-color);
    border-radius: 4px;
    align-items: center;
}

.metric-value {
    font-size: 22px;
    color: var(--accent);
    -unity-font-style: bold;
}

.panel {
    background-color: var(--panel-bg);
    border-width: 1px;
    border-color: var(--border-color);
    border-radius: 6px;
    margin: 8px;
    padding: 8px;
    flex-direction: column;
}

.panel-title {
    font-size: 12px;
    color: var(--accent-soft);
    margin-bottom: 8px;
}

.logs-scroll {
    max-height: 200px;
}

.log-entry {
    font-size: 10px;
    padding: 2px 4px;
}

#LogsPanel .unity-list-view__item {
    font-size: 10px;
    padding: 2px 6px;
}

.console-line {
    font-size: 11px;
    padding: 2px 4px;
    color: rgb(160, 255, 160);
}

.viz-toggle {
    margin: 2px 0;
}

.robot-panel {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.robot-info {
    flex-grow: 1;
}

.robot-progress {
    margin-top: 6px;
    width: 150px;
}

.bottom-controls {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px 16px;
    border-top-width: 1px;
    border-top-color: var(--border-color);
}

.control-button {
    margin-left: 8px;
    min-width: 80px;
}

.speed-slider {
    width: 120px;
}

.tab-pane {
    padding: 8px;
}

.view-dropdown {
    background-color: var(--dropdown-bg);
    border-radius: 8px;
    color: var(--dropdown-text);
    font-size: 12px;
    height: 32px;
    min-width: 80px;
    padding: 0 8px;
    border-width: 0;
}

.view-dropdown .unity-base-text-field__input {
    color: var(--dropdown-text);
}

.view-dropdown .unity-popup-field__arrow {
    color: var(--dropdown-text);
    width: 16px;
}

.dashboard-panel {
    position: relative;
    margin: 8px;
    background-color: var(--panel-bg);
    border-width: 1px;
    border-color: var(--accent-glow);
    border-radius: 12px;
    padding: 16px 12px 12px 12px;
    transition: border-color 0.2s;
}

.dashboard-panel:hover {
    border-color: var(--accent-soft);
    background-color: var(--bg-secondary);
}

.panel-title-corner {
    position: absolute;
    top: -12px;
    left: 16px;
    background-color: var(--title-corner-bg);
    padding: 0 10px;
    font-size: 14px;
    letter-spacing: 1.2px;
    color: var(--title-corner-color);
    border-radius: 20px;
    border-width: 1px;
    border-color: var(--accent-glow);
}

.panel-inner {
    flex-direction: column;
    margin-top: 6px;
}

.metric-line {
    color: var(--text-primary);
    font-size: 12px;
    margin-bottom: 6px;
}

/* ===== DROPDOWN STYLES ===== */
.unity-base-field__input {
    color: var(--text-secondary);
    background-color: var(--bg-secondary);
    border-color: var(--border-color);
    border-radius: 4px;
}

.unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--text-secondary);
}

.unity-base-field__label {
    color: var(--text-secondary);
    font-size: 28px;
}

.unity-base-dropdown .unity-scroll-view {
    background-color: var(--bg-secondary);
    color: var(--text-secondary);
    border-color: var(--border-color);
    border-radius: 4px;
}

.unity-base-dropdown__item {
    flex-grow: 1;
}

.unity-base-dropdown #unity-content-container {
    flex-direction: column;
}

.unity-base-dropdown__checkmark {
    -unity-background-image-tint-color: var(--text-secondary);
}

.unity-base-dropdown__container-outer {
    border-color: var(--border-color);
    border-radius: 4px;
}