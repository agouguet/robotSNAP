/* ========================================
   VARIABLES GLOBALES (thème)
   ======================================== */
:root {
    --bg-primary: #08101E;
    --bg-secondary: #0f1117;
    --panel-bg: rgba(30, 34, 42, 0.85);
    --text-primary: #e0e0e0;
    --text-secondary: #8c8f96;
    --accent: #022864;
    --accent-glow: rgba(45, 156, 219, 0.2);
    --border: #2c313a;
}

.dark-mode {
    --bg-primary: #0a0c10;
    --text-primary: #cccccc;
    /* etc. */
}

/* ========================================
   STYLES GLOBAUX
   ======================================== */
.root {
    background-color: var(--bg-primary);
    background-size: cover;
}

.root, #MainContainer, #MainContent {
    height: 100%;
    width: 100%;
}

.unity-label {
    color: var(--text-primary);
    font-size: 12px;
}

.unity-panel {
    background-color: var(--panel-bg);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 4px;
    padding: 8px;
    margin: 4px;
}

.unity-button {
    background-color: #2c313a;
    border-width: 0;
    border-radius: 4px;
    padding: 6px 12px;
    color: var(--text-primary);
}

.unity-button:hover {
    background-color: #3a404b;
}

.button-accent {
    background-color: var(--accent);
    color: #1a1e24;
}

/* ========================================
   COMPOSANTS PRINCIPAUX
   ======================================== */

/* Top Bar */
.top-bar {
    padding: 12px 16px;
}

.simulator-title {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--text-primary);
}

.simulator-desc {
    font-size: 16px;
    color: var(--text-secondary);
    margin-top: 4px;
}

.view-selector {
    flex-direction: row;
    margin-top: 12px;
}

.view-button {
    background-color: #2c313a;
    padding: 4px 12px;
    border-radius: 4px;
    width: 64px; 
    height: 64px; 
    margin: 16px; 
    border-radius: 8px;
}

.view-button.active {
    background-color: var(--accent);
    color: #111;
}

.full-screen-button{
    width: 64px; 
    height: 64px; 
    margin: 16px; 
    pointer-events: auto; 
    background-size: contain; 
    background-color: rgb(8, 16, 30); 
    border-radius: 8px;
}

/* Panneau de simulation */
.simulation-view {
    background-color: #0a0c10;
    border-radius: 6px;
    margin: 8px;
    padding: 8px;
}

.render-zone {
    background-color: #000000;
    min-height: 300px;
    border-radius: 4px;
}

.simulation-status {
    margin-top: 12px;
    padding: 8px;
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 4px;
}

/* Métriques (cartes) */
.metrics-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 8px;
}

.metric-card {
    flex-grow: 1;
    margin: 4px;
    padding: 8px;
    background-color: #0f1117;
    border-width: 1px;
    border-color: var(--border);
    border-radius: 4px;
    align-items: center;
    text-align: center;
}

.metric-value {
    font-size: 22px;
    color: var(--accent);
    -unity-font-style: bold;
}

/* Panneaux génériques */
.panel {
    background-color: var(--panel-bg);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 6px;
    margin: 8px;
    padding: 8px;
    flex-direction: column;
}

.panel-title {
    font-size: 12px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 8px;
}

/* Logs */
.logs-scroll {
    max-height: 200px;
}

.log-entry {
    font-family: monospace;
    font-size: 10px;
    padding: 2px 4px;
}

#LogsPanel .unity-list-view__item {
    font-family: "Courier New", monospace;
    font-size: 10px;
    padding: 2px 6px;
}

/* Console (onglet) */
.console-line {
    font-family: monospace;
    font-size: 11px;
    padding: 2px 4px;
    color: #a0ffa0;
}

/* Vizualisations toggles */
.viz-toggle {
    margin: 2px 0;
}

/* Robot panel */
.robot-panel {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.robot-info {
    flex-grow: 1;
}

.robot-name {
    font-weight: bold;
}

.robot-progress {
    margin-top: 6px;
    width: 150px;
}

.simulation-overlay {
    padding: 0px 8px 16px 8px;
}

.bottom-controls {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px 16px;
    border-top-width: 1px;
    border-top-color: var(--border);
}

.control-button {
    margin-left: 8px;
    min-width: 80px;
}

.speed-slider {
    width: 120px;
}

/* Panneau à onglets (bas) */
.bottom-tabs-panel {
    margin: 8px;
    background-color: var(--panel-bg);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 6px;
    flex-direction: column;
}

.tabs-toolbar {
    flex-direction: row;
    background-color: var(--bg-secondary);
}

.tab-button {
    background-color: transparent;
    border-width: 0;
    padding: 8px 16px;
    margin: 0;
    font-size: 12px;
    color: var(--text-secondary);
}

.tab-button.active {
    color: var(--accent);
    background-color: rgba(45, 156, 219, 0.1);
}

.tab-pane {
    padding: 8px;
    overflow: auto;
}

.view-dropdown {
    background-color: rgb(8, 16, 30);
    border-radius: 8px;
    color: rgb(165, 215, 255);
    font-size: 12px;
    height: 32px;
    min-width: 80px;
    padding: 0 8px;
    border-width: 0;
}

.view-dropdown .unity-base-text-field__input {
    color: rgb(165, 215, 255);
    text-align: center;
}

.view-dropdown .unity-popup-field__arrow {
    color: rgb(165, 215, 255);
    width: 16px;
}


/* Panneau de base */
.dashboard-panel {
    position: relative;
    background-color: rgba(16, 20, 28, 0.7);
    border: 1px solid rgba(45, 156, 219, 0.4);
    border-radius: 12px;
    margin: 16px 12px;
    padding: 16px 12px 12px 12px;
    transition: border 0.2s, box-shadow 0.2s;
}

/* Légère illumination au survol */
.dashboard-panel:hover {
    border-color: rgba(45, 156, 219, 0.9);
    background-color: rgba(16, 20, 28, 0.85);
}

/* TITRE POSITIONNÉ DANS LE COIN SUPÉRIEUR GAUCHE, À CHEVAL SUR LA BORDURE */
.panel-title-corner {
    position: absolute;
    top: -12px;
    left: 16px;
    background-color: #0f1117;   /* couleur de fond du titre */
    padding: 0 10px;
    font-size: 14px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: #a5d7ff;              /* cyan clair */
    border-radius: 20px;
    /* Effet glow */
    text-shadow: 0 0 5px rgba(45, 156, 219, 0.6),
                 0 0 8px rgba(45, 156, 219, 0.3);
    /* Petite bordure discrète autour du texte */
    border: 1px solid rgba(45, 156, 219, 0.3);
    backdrop-filter: blur(2px);
    z-index: 2;
}

/* Contenu interne */
.panel-inner {
    flex-direction: column;
    margin-top: 6px;
}

/* Style des lignes de métriques */
.metric-line {
    color: #e0e4ec;
    font-size: 12px;
    margin-bottom: 6px;
    -unity-font-style: normal;
}

/* Option : ajouter une petite icône ou un séparateur */
.metric-line:first-of-type {
    margin-top: 4px;
}