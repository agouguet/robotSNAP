/* ========================================
   VARIABLES GLOBALES – THEME CLAIR (défaut)
   ======================================== */
:root {
    /* Fonds */
    --bg-primary: #e7eaec;      /* fond principal très clair */
    --bg-secondary: #FFFFFF;    /* fond secondaire (cartes, panels) */
    --sidebar-bg: #FFFFFF;      /* fond de la sidebar */
    --panel-bg: rgba(255, 255, 255, 0.92); /* panels semi-transparents */
    --card-bg: #FFFFFF;         /* cartes métriques */
    
    /* Textes */
    --text-primary: #0F172A;    /* texte principal (très foncé) */
    --text-secondary: #475569;  /* texte secondaire */
    
    /* Accents */
    --accent: #2563EB;          /* bleu vif pour les éléments actifs */
    --accent-soft: #3B82F6;     /* bleu plus doux */
    --accent-glow: rgba(37, 99, 235, 0.15); /* halo léger */
    
    /* Bordures & séparateurs */
    --border-color: #E2E8F0;
    
    /* Éléments interactifs */
    --button-bg: #F1F5F9;
    --button-hover: #c7ccd3;
    
    /* Titres flottants */
    --title-corner-bg: #FFFFFF;
    --title-corner-color: #2563EB;
    
    /* Dropdown */
    --dropdown-bg: #FFFFFF;
    --dropdown-text: #0F172A;

    --icon-tint: #161a1f;
}

/* ========================================
   THEME SOMBRE (activé par la classe .dark-mode)
   ======================================== */
.dark-mode {
    /* Fonds */
    --bg-primary: #0B1120;      /* fond très sombre, légèrement bleuté */
    --bg-secondary: #1E293B;    /* fond secondaire */
    --sidebar-bg: #0F172A;      /* sidebar légèrement plus claire que le fond principal */
    --panel-bg: rgba(30, 41, 59, 0.85);
    --card-bg: #1E293B;
    
    /* Textes */
    --text-primary: #F1F5F9;    /* blanc cassé */
    --text-secondary: #94A3B8;  /* gris clair */
    
    /* Accents */
    --accent: #3B82F6;          /* bleu plus lumineux pour rester visible */
    --accent-soft: #60A5FA;
    --accent-glow: rgba(59, 130, 246, 0.2);
    
    /* Bordures */
    --border-color: #334155;
    
    /* Éléments interactifs */
    --button-bg: #334155;
    --button-hover: #475569;
    
    /* Titres flottants */
    --title-corner-bg: #1E293B;
    --title-corner-color: #60A5FA;
    
    /* Dropdown */
    --dropdown-bg: #1E293B;
    --dropdown-text: #F1F5F9;

    --icon-tint: #F1F5F9;
}

/* ========================================
   STYLES GLOBAUX
   ======================================== */
.root {
    background-color: var(--bg-primary);
    background-size: cover;
}

.root, #MainContainer, #MainContent {
    height: 100%;
    width: 100%;
}

#MainContainer {
    background-color: var(--bg-primary);
}


.unity-label {
    color: var(--text-primary);
    font-size: 12px;
}

.unity-panel {
    background-color: var(--panel-bg);
    border-width: 1px;
    border-style: solid;
    border-color: var(--border-color);
    border-radius: 4px;
    padding: 8px;
    margin: 4px;
}

.unity-button {
    background-color: var(--button-bg);
    border-width: 0;
    border-radius: 4px;
    padding: 6px 12px;
    color: var(--text-primary);
}

.unity-button:hover {
    background-color: var(--button-hover);
}

.button-icon {
    width: 28px;
    height: 28px;
    margin-right: 8px;
    background-size: contain;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--icon-tint);
}

.button-label {
    color: var(--text-primary);
    font-size: 14px;
}

.button-accent {
    background-color: var(--accent);
    color: #FFFFFF;
}

/* ========================================
   COMPOSANTS PRINCIPAUX
   ======================================== */

/* Top Bar */
.top-bar {
    padding: 12px 16px;
}

.simulator-title {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--text-primary);
}

.simulator-desc {
    font-size: 16px;
    color: var(--text-secondary);
    margin-top: 4px;
}

.view-selector {
    flex-direction: row;
    margin-top: 12px;
}

/* Panneau de simulation */
.simulation-view {
    background-color: var(--bg-secondary);
    border-radius: 6px;
    margin: 8px;
    padding: 8px;
}

.render-zone {
    background-color: #000000;
    min-height: 300px;
    border-radius: 4px;
}

.simulation-status {
    margin-top: 12px;
    padding: 8px;
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 4px;
}

/* Métriques (cartes) */
.metrics-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 8px;
}

.metric-card {
    flex-grow: 1;
    margin: 4px;
    padding: 8px;
    background-color: var(--card-bg);
    border-width: 1px;
    border-style: solid;
    border-color: var(--border-color);
    border-radius: 4px;
    align-items: center;
    text-align: center;
}

.metric-value {
    font-size: 22px;
    color: var(--accent);
    -unity-font-style: bold;
}

/* Panneaux génériques */
.panel {
    background-color: var(--panel-bg);
    border-width: 1px;
    border-style: solid;
    border-color: var(--border-color);
    border-radius: 6px;
    margin: 8px;
    padding: 8px;
    flex-direction: column;
}

.panel-title {
    font-size: 12px;
    text-transform: uppercase;
    color: var(--accent-soft);
    margin-bottom: 8px;
}

/* Logs */
.logs-scroll {
    max-height: 200px;
}

.log-entry {
    font-family: monospace;
    font-size: 10px;
    padding: 2px 4px;
}

#LogsPanel .unity-list-view__item {
    font-family: "Courier New", monospace;
    font-size: 10px;
    padding: 2px 6px;
}

/* Console (onglet) */
.console-line {
    font-family: monospace;
    font-size: 11px;
    padding: 2px 4px;
    color: #A0FFA0;
}

/* Vizualisations toggles */
.viz-toggle {
    margin: 2px 0;
}

/* Robot panel */
.robot-panel {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.robot-info {
    flex-grow: 1;
}

.robot-name {
    font-weight: bold;
}

.robot-progress {
    margin-top: 6px;
    width: 150px;
}

.simulation-overlay {
    padding: 0px 8px 16px 8px;
}

.bottom-controls {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px 16px;
    border-top-width: 1px;
    border-top-style: solid;
    border-top-color: var(--border-color);
}

.control-button {
    margin-left: 8px;
    min-width: 80px;
}

.speed-slider {
    width: 120px;
}

/* Panneau à onglets (bas) */
.bottom-tabs-panel {
    margin: 8px;
    background-color: var(--panel-bg);
    border-width: 1px;
    border-style: solid;
    border-color: var(--border-color);
    border-radius: 6px;
    flex-direction: column;
}

.tabs-toolbar {
    flex-direction: row;
    background-color: var(--bg-secondary);
}

.tab-button {
    background-color: transparent;
    border-width: 0;
    padding: 8px 16px;
    margin: 0;
    font-size: 12px;
    color: var(--text-secondary);
}

.tab-button.active {
    color: var(--accent-soft);
    background-color: var(--accent-glow);
}

.tab-pane {
    padding: 8px;
    overflow: auto;
}

.view-dropdown {
    background-color: var(--dropdown-bg);
    border-radius: 8px;
    color: var(--dropdown-text);
    font-size: 12px;
    height: 32px;
    min-width: 80px;
    padding: 0 8px;
    border-width: 0;
}

.view-dropdown .unity-base-text-field__input {
    color: var(--dropdown-text);
    text-align: center;
}

.view-dropdown .unity-popup-field__arrow {
    color: var(--dropdown-text);
    width: 16px;
}

/* Panneau de type dashboard (avec titre flottant) */
.dashboard-panel {
    position: relative;
    background-color: var(--panel-bg);
    border-width: 1px;
    border-style: solid;
    border-color: var(--accent-glow);
    border-radius: 12px;
    margin: 16px 12px;
    padding: 16px 12px 12px 12px;
    transition: border-color 0.2s;
}

.dashboard-panel:hover {
    border-color: var(--accent-soft);
    background-color: var(--bg-secondary);
}

/* Titre flottant */
.panel-title-corner {
    position: absolute;
    top: -12px;
    left: 16px;
    background-color: var(--title-corner-bg);
    padding: 0 10px;
    font-size: 14px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: var(--title-corner-color);
    border-radius: 20px;
    border-width: 1px;
    border-style: solid;
    border-color: var(--accent-glow);
    z-index: 2;
}

/* Contenu interne */
.panel-inner {
    flex-direction: column;
    margin-top: 6px;
}

/* Lignes de métriques */
.metric-line {
    color: var(--text-primary);
    font-size: 12px;
    margin-bottom: 6px;
}