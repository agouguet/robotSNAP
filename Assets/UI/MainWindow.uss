/* Palette */
:root {
    --bg-primary: #1a1e24;
    --bg-secondary: #0f1117;
    --panel-bg: rgba(30, 34, 42, 0.85);
    --text-primary: #e0e0e0;
    --text-secondary: #8c8f96;
    --accent: #2d9cdb;
    --accent-glow: rgba(45, 156, 219, 0.2);
    --border: #2c313a;
}

/* Style global */
.unity-label {
    color: var(--text-primary);
    font-size: 12px;
}

.unity-panel {
    background-color: var(--panel-bg);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 4px;
    padding: 8px;
    margin: 4px;
}

/* Menu latéral */
#Sidebar {
    width: 260px;
    background-color: var(--bg-secondary);
    border-right-width: 1px;
    border-right-color: var(--border);
    padding: 16px 8px;
}

#Sidebar .unity-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--accent);
}

#Sidebar .menu-item {
    padding: 6px 12px;
    margin: 2px 0;
    border-radius: 4px;
}

#Sidebar .menu-item:hover {
    background-color: var(--accent-glow);
}

/* Cartes métriques */
.metric-card {
    background-color: rgba(0, 0, 0, 0.4);
    border-width: 1px;
    border-color: var(--accent);
    border-radius: 4px;
    padding: 8px;
    text-align: center;
}

.metric-value {
    font-size: 24px;
    color: var(--accent);
    -unity-font-style: bold;
}

/* Logs - style console */
#LogsPanel .unity-list-view__item {
    font-family: "Courier New", monospace;
    font-size: 10px;
    padding: 2px 6px;
    /* border-bottom: 1px solid var(--border); */
}

/* Boutons */
.unity-button {
    background-color: #2c313a;
    border-width: 0;
    border-radius: 4px;
    padding: 6px 12px;
    color: var(--text-primary);
}

.unity-button:hover {
    background-color: #3a404b;
}

.button-accent {
    background-color: var(--accent);
    color: #1a1e24;
}



.top-bar {
    padding: 12px 16px;
    /* border-bottom-width: 1px;
    border-bottom-color: var(--border); */
    background-color: var(--bg-secondary);
}

.simulator-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--text-primary);
}

.simulator-desc {
    font-size: 12px;
    color: var(--text-secondary);
    margin-top: 4px;
}

.view-selector {
    flex-direction: row;
    margin-top: 12px;
}

.view-button {
    background-color: #2c313a;
    margin-left: 6px;
    padding: 4px 12px;
    border-radius: 4px;
}

.view-button.active {
    background-color: var(--accent);
    color: #111;
}

.simulation-view {
    background-color: #0a0c10;
    border-radius: 6px;
    margin: 8px;
    padding: 8px;
}

.render-zone {
    background-color: #000000;
    min-height: 300px;
    border-radius: 4px;
}

.simulation-status {
    margin-top: 12px;
    padding: 8px;
    background-color: rgba(0,0,0,0.4);
    border-radius: 4px;
}

.metrics-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 8px;
}

.metric-card {
    flex-grow: 1;
    margin: 4px;
    padding: 8px;
    background-color: #0f1117;
    border-width: 1px;
    border-color: var(--border);
    border-radius: 4px;
    align-items: center;
}

.metric-value {
    font-size: 22px;
    color: var(--accent);
}

.panel {
    background-color: var(--panel-bg);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 6px;
    margin: 8px;
    padding: 8px;
    flex-direction: column;
}

.panel-title {
    font-size: 12px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 8px;
}

.viz-toggle {
    margin: 2px 0;
}

.logs-scroll {
    max-height: 200px;
}

.log-entry {
    font-family: monospace;
    font-size: 10px;
    padding: 2px 4px;
    /* border-bottom: 1px solid var(--border); */
}

.robot-panel {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.robot-info {
    flex-grow: 1;
}

.robot-name {
    font-weight: bold;
}

.robot-progress {
    margin-top: 6px;
    width: 150px;
}

.bottom-controls {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px 16px;
    border-top-width: 1px;
    border-top-color: var(--border);
}

.control-button {
    margin-left: 8px;
    min-width: 80px;
}

.speed-slider {
    width: 120px;
}

.bottom-tabs-panel {
    margin: 8px;
    background-color: var(--panel-bg);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 6px;
    flex-direction: column;
}

.tabs-toolbar {
    flex-direction: row;
    background-color: var(--bg-secondary);
    /* border-bottom-width: 1px;
    border-bottom-color: var(--border); */
}

.tab-button {
    background-color: transparent;
    border-width: 0;
    padding: 8px 16px;
    margin: 0;
    font-size: 12px;
    color: var(--text-secondary);
}

.tab-button.active {
    color: var(--accent);
    /* border-bottom-width: 2px;
    border-bottom-color: var(--accent); */
    background-color: rgba(45, 156, 219, 0.1);
}

.tab-pane {
    padding: 8px;
    overflow: auto;
}

.console-line {
    font-family: monospace;
    font-size: 11px;
    padding: 2px 4px;
    /* border-bottom: 1px solid var(--border); */
    color: #a0ffa0;
}

/* Style pour le conteneur de la barre d'onglets */
.tabs-toolbar {
    flex-direction: row;
    background-color: var(--bg-secondary);
    /* border-bottom-width: 1px;
    border-bottom-style: solid;
    border-bottom-color: var(--border); */
}

/* Style pour chaque bouton d'onglet */
.tab-button {
    background-color: transparent;
    border-width: 0;
    padding: 8px 16px;
    margin: 0;
    font-size: 12px;
    color: var(--text-secondary);
}

/* Style pour l'onglet actif */
.tab-button.active {
    color: var(--accent);
    /* border-bottom-width: 2px;
    border-bottom-style: solid;
    border-bottom-color: var(--accent); */
    background-color: rgba(45, 156, 219, 0.1);
}