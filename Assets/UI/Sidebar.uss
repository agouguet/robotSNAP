/* =========================
   SIDEBAR – État normal
========================= */
.sidebar {
    width: 260px;
    height: 100%;
    background-color: rgb(8, 16, 30);
    flex-direction: column;
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.05);
    transition: width 0.1s ease-out;  /* transition rapide et fluide */
    overflow: hidden;
}

/* =========================
   SIDEBAR – État rétracté (collapsed)
========================= */
.sidebar.collapsed {
    width: 86px;   /* doit correspondre à CollapsedWidth dans le script */
}

/* On masque les textes (labels) */
.sidebar.collapsed .app-title,
.sidebar.collapsed .app-subtitle,
.sidebar.collapsed .menu-label,
.sidebar.collapsed .toggle-dark .unity-toggle__label,
.sidebar.collapsed .collapse-label {
    display: none;
}

/* Ajustement du logo */
.sidebar.collapsed .app-logo {
    width: 70px;
    height: 70px;
    margin-right: 0;
}

/* Centrage des icônes dans les items de menu */
.sidebar.collapsed .menu-item {
    justify-content: center;
    padding-left: 0;
    padding-right: 0;
    height: 54px;
}

/* On conserve une marge interne pour éviter le "collé" */
.sidebar.collapsed .menu-icon {
    width: 36px;
    height: 36px;
    margin-right: 0px;
    background-size: 100% 100%;
    -unity-background-scale-mode: scale-to-fit;       
}

/* Ajustement du conteneur de collapse */
.sidebar.collapsed .collapse-container {
    justify-content: center;
    padding-left: 0;
    padding-right: 0;
}

/* Style de la flèche en mode collapsed */
.sidebar.collapsed .collapse-button-icon {
    color: rgba(255, 255, 255, 0.7);
}

/* =========================
   TOP BAR (en-tête avec logo + titre)
========================= */
.sidebar-top {
    height: 110px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 8px;
    padding-right: 8px;
    flex-shrink: 0;
}

.branding {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    flex-grow: 1;
}

.app-logo {
    width: 100px;
    height: 100px;
    background-size: contain;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.branding-text {
    flex-direction: column;
    flex-grow: 1;
    justify-content: center;
}

.app-title {
    color: white;
    font-size: 42px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}
/* Première ligne "Robot" */
.app-title:first-child {
    color: rgb(165, 215, 255);
}
/* Deuxième ligne "SNAP" */
.app-title:last-child {
    color: rgb(236, 163, 63);
    -unity-text-outline-color: rgb(236, 163, 63);
}

/* =========================
   CONTENU PRINCIPAL DE LA SIDEBAR
========================= */
.sidebar-content {
    flex-grow: 1;
    flex-direction: column;
    padding-left: 12px;
    padding-right: 12px;
    padding-bottom: 16px;
    overflow: hidden;
}

/* =========================
   GROUPES DE MENU
========================= */
.menu-group {
    flex-direction: column;
}

/* =========================
   ÉLÉMENT DE MENU (bouton)
========================= */
.menu-item {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    height: 54px;
    margin-bottom: 6px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0);
    border-width: 0;
    color: white;
}

.menu-item:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.menu-item.active {
    background-color: var(--accent);
}

/* =========================
   LABEL DU MENU
========================= */
.menu-label {
    color: rgba(255, 255, 255, 0.85);
    font-size: 16px;
    unity-text-align: middle-left;
    flex-grow: 1;
}

.menu-item.active .menu-label {
    color: white;
}

/* =========================
   ICÔNES DES MENUS
========================= */
.menu-icon {
    width: 28px;
    height: 28px;
    margin-right: 12px;
    background-size: 100% 100%;
    -unity-background-scale-mode: scale-to-fit;
}

/* =========================
   SÉPARATEUR
========================= */
.separator {
    height: 1px;
    margin-top: 12px;
    margin-bottom: 12px;
    background-color: rgba(255, 255, 255, 0.08);
}

/* =========================
   ZONE DES ACTIONS EN BAS (dark mode + collapse)
========================= */
.bottom-actions {
    padding-top: 12px;
}

#DarkModeToggle {
    height: 54px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 10px;
    background-color: transparent;
    border-width: 0;
    color: white;
}
#DarkModeToggle:hover {
    background-color: rgba(255, 255, 255, 0.05);
}
#DarkModeToggle .menu-label {
    color: rgba(255, 255, 255, 0.85);
}

.collapse-container {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 16px;
    padding: 8px 12px;
    border-radius: 8px;
    background-color: transparent;
    transition: background-color 0.1s;
}
.collapse-container:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.collapse-label {
    color: rgba(255, 255, 255, 0.5);
    font-size: 13px;
}

.collapse-button-icon {
    background-color: transparent;
    border-width: 0;
    color: rgba(255, 255, 255, 0.7);
    font-size: 16px;
    width: 24px;
    height: 24px;
    padding: 0;
    margin: 0;
    unity-text-align: middle-center;
}
.collapse-button-icon:hover {
    color: white;
}