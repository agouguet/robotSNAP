/* =========================
   SIDEBAR – État normal
========================= */
.sidebar {
    width: 260px;
    height: 100%;
    background-color: var(--sidebar-bg);
    flex-direction: column;
    border-right-width: 1px;
    border-right-style: solid;
    border-right-color: var(--border-color);
    transition: width 0.12s ease-out;
    overflow-x: hidden;
}

.sidebar.collapsed {
    width: 86px;
}

/* Masquage immédiat des textes pour éviter le flash */
.sidebar.collapsed .app-title,
.sidebar.collapsed .app-subtitle,
.sidebar.collapsed .menu-label,
.sidebar.collapsed .collapse-label,
.sidebar.collapsed .unity-base-field__label {
    display: none;
    /* On force le masquage dès le début de l'animation */
}

/* Logo */
.sidebar.collapsed .app-logo {
    width: 70px;
    height: 70px;
    margin-right: 0;
}

/* Centrage des icônes */
.sidebar.collapsed .menu-item {
    justify-content: center;
    padding-left: 0;
    padding-right: 0;
    height: 54px;
}

.sidebar.collapsed .menu-icon {
    width: 36px;
    height: 36px;
    margin-right: 0;
    background-size: 100% 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.sidebar.collapsed .collapse-container {
    justify-content: center;
    padding-left: 0;
    padding-right: 0;
}

.sidebar.collapsed .collapse-button-icon {
    color: var(--text-secondary);
}

/* =========================
   TOP BAR
========================= */
.sidebar-top {
    height: 110px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 8px;
    padding-right: 8px;
    flex-shrink: 0;
}

.branding {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    flex-grow: 1;
}

.app-logo {
    width: 100px;
    height: 100px;
    background-size: contain;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.branding-text {
    flex-direction: column;
    flex-grow: 1;
    justify-content: center;
}

.app-title {
    transition-property: opacity;
    transition-duration: 0.12s;
    transition-delay: 0.10s;     /* délai à la réapparition (quand on enlève .collapsed) */
    opacity: 1;
}

.app-title.robot-title {
    color: var(--accent-soft);
}
.app-title.snap-title {
    color: #ECA33F;
    -unity-text-outline-color: #ECA33F;
}

.sidebar.collapsed .app-title {
    transition-delay: 0s;         /* pas de délai à la disparition */
    opacity: 0;
}

/* =========================
   CONTENU
========================= */
.sidebar-content {
    flex-grow: 1;
    flex-direction: column;
    padding-left: 12px;
    padding-right: 12px;
    padding-bottom: 16px;
    overflow: hidden;
}

.menu-group {
    flex-direction: column;
}

.menu-item {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    height: 54px;
    margin-bottom: 6px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 10px;
    background-color: transparent;
    border-width: 0;
    color: var(--text-primary);
}

.menu-item:hover {
    background-color: rgba(128, 128, 128, 0.3);
}

.menu-item.active {
    background-color: var(--accent);
}

.menu-label {
    color: var(--text-secondary);
    font-size: 16px;
    unity-text-align: middle-left;
    flex-grow: 1;
}

.menu-item.active .menu-label {
    color: #FFFFFF;
}

.menu-icon {
    width: 28px;
    height: 28px;
    margin-right: 12px;
    background-size: 100% 100%;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--icon-tint);
}

.menu-item.active .menu-icon {
    -unity-background-image-tint-color: #FFFFFF;
}

.separator {
    height: 1px;
    margin-top: 12px;
    margin-bottom: 12px;
    background-color: var(--border-color);
}

.bottom-actions {
    padding-top: 12px;
}

/* =========================
   DARK MODE TOGGLE
========================= */
.dark-mode-container {
    justify-content: space-between;
    width: 100%;
}

.dark-mode-container .unity-base-field__label {
    flex-grow: 1;
    color: var(--text-secondary);
    font-size: 16px;
}

.slide-toggle {
    flex-direction: row;
    align-items: center;
}

.slide-toggle__icon {
    width: 28px;
    height: 28px;
    background-size: contain;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
    margin-right: 12px;
    -unity-background-image-tint-color: var(--icon-tint);
}

/* Mode collapsed : vertical */
.sidebar.collapsed .dark-mode-container {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: auto;
    padding: 8px 0;
    width: 100%;
}

.sidebar.collapsed .dark-mode-container .unity-base-field__label {
    display: none;
}

.sidebar.collapsed .dark-mode-switch {
    flex-direction: column;
    align-items: center;
}

.sidebar.collapsed .dark-mode-switch .slide-toggle__icon {
    margin-right: 0;
    margin-bottom: 6px;
}

.sidebar.collapsed .dark-mode-switch .slide-toggle__input {
    width: 36px;
    height: 20px;
}
.sidebar.collapsed .dark-mode-switch .slide-toggle__input-knob {
    width: 16px;
    height: 16px;
}
.sidebar.collapsed .dark-mode-switch.slide-toggle__input--checked .slide-toggle__input-knob {
    translate: 18px 0;
}

/* =========================
   COLLAPSE BUTTON
========================= */
.collapse-container {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 16px;
    padding: 8px 12px;
    border-radius: 8px;
    background-color: transparent;
    transition: background-color 0.1s;
}
.collapse-container:hover {
    background-color: rgba(128, 128, 128, 0.1);
}

.collapse-label {
    color: var(--text-secondary);
    font-size: 13px;
}

.collapse-button-icon {
    background-color: transparent;
    border-width: 0;
    color: var(--text-secondary);
    font-size: 16px;
    width: 24px;
    height: 24px;
    padding: 0;
    margin: 0;
    unity-text-align: middle-center;
}
.collapse-button-icon:hover {
    color: var(--text-primary);
}