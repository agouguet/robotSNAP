<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="SimulationView" style="width: auto; flex-direction: row; flex-grow: 1;">
        <ui:VisualElement name="VisualElement" style="flex-grow: 1;"/>
        <ui:VisualElement name="VisualElement" style="flex-grow: 0;">
            <ui:Button text="3D" name="3DButton" style="width: 64px; height: 64px; align-items: flex-end;"/>
            <ui:Button text="2D" name="2DButton" style="width: 64px; height: 64px; align-items: flex-end;"/>
            <ui:VisualElement style="flex-grow: 1;"/>
            <ui:Button text="" name="FullScreenButton" style="width: 64px; height: 64px; align-items: flex-end; background-image: resource(&quot;UI/icons/fullscreen&quot;);"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
