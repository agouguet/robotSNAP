/* ================================================================
   LEFT : SCENARIO BROWSER
   ================================================================ */

.scenario-browser-view {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    flex-direction: column;

    background-color: var(--bg-primary);

    padding-left: 24px;
    padding-right: 24px;
    padding-top: 20px;
    padding-bottom: 16px;
}

.scenario-browser {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    flex-direction: column;
    padding-right: 24px;
}




/* ================================================================
   TOOLBAR
   ================================================================ */

.scenario-toolbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    flex-shrink: 0;
}


.scenario-search-container {
    flex-grow: 1;
    max-width: 420px;
    min-width: 200px;
    height: 42px;

    flex-direction: row;
    align-items: center;

    background-color: var(--bg-secondary);

    border-radius: 8px;
    border-width: 1px;
    border-style: solid;
    border-color: var(--border-color);

    padding-left: 12px;
    padding-right: 12px;

    margin-right: 12px;
}


.scenario-search-container:focus {
    border-color: var(--accent);
}


.scenario-search-icon {
    width: 18px;
    height: 18px;
    margin-right: 8px;

    flex-shrink: 0;

    -unity-background-image-tint-color: var(--text-secondary);
}


.scenario-search-field {
    flex-grow: 1;

    background-color: transparent;

    border-width: 0;

    padding: 8px 0;

    color: var(--text-primary);

    font-size: 14px;

    min-height: 36px;

    --unity-cursor-color: var(--text-primary);
}


.scenario-search-field .unity-text-field__input {
    background-color: transparent;
    border-width: 0;
    padding: 0;

    color: var(--text-primary);
    font-size: 14px;
}


.scenario-search-field:focus {
    border-color: transparent;
}


.scenario-search-field .unity-text-field__input:focus {
    border-color: transparent;
}


/* ================================================================
   FILTERS
   ================================================================ */

.scenario-filters {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}


.scenario-filter-dropdown,
.scenario-sort-dropdown {
    width: 145px;
    height: 42px;
    flex-shrink: 0;
}


.scenario-filter-dropdown {
    margin-right: 8px;
}


/* ================================================================
   LIST HEADER
   ================================================================ */

.scenario-list-header {
    flex-direction: row;
    align-items: center;

    min-height: 28px;

    margin-bottom: 8px;
    padding-left: 2px;
}


.scenario-count-label {
    font-size: 12px;
    color: var(--text-secondary);
}


/* ================================================================
   SCENARIO LIST
   ================================================================ */

.scenario-list-view {
    flex-grow: 1;
    min-height: 0;

    background-color: var(--bg-primary);

    border-radius: 8px;

    border-width: 1px;
    border-style: solid;
    border-color: var(--border-color);

    padding: 10px;
}


/* ================================================================
   SCENARIO GRID
   ================================================================ */

.scenario-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}


/* ================================================================
   SCENARIO CARD
   ================================================================ */

.scenario-card-page {
    width: 48%;
    min-width: 220px;

    margin-right: 2%;
    margin-bottom: 14px;

    background-color: var(--bg-secondary);

    border-radius: 10px;

    border-width: 1px;
    border-style: solid;
    border-color: var(--border-color);

    overflow: hidden;

    transition:
        border-color 0.2s,
        background-color 0.2s;
}


.scenario-card-page:hover {
    border-color: var(--accent-soft);
    background-color: var(--card-bg);
}


/* ================================================================
   SELECTED CARD
   ================================================================ */

.scenario-card-page.selected {
    border-color: var(--accent);
}


/* ================================================================
   CARD PREVIEW
   ================================================================ */

.scenario-card-preview {
    position: relative;

    width: 100%;
    height: 145px;

    background-color: var(--bg-primary);

    overflow: hidden;
}


.scenario-preview-image {
    width: 100%;
    height: 100%;

    -unity-scale-mode: scale-and-crop;
}


/* ================================================================
   SELECTED INDICATOR
   ================================================================ */

.scenario-card-selected-indicator {
    position: absolute;

    top: 10px;
    right: 10px;

    width: 9px;
    height: 9px;

    border-radius: 5px;

    background-color: var(--accent);

    display: none;
}


.scenario-card-page.selected .scenario-card-selected-indicator {
    display: flex;
}


/* ================================================================
   CARD CONTENT
   ================================================================ */

.scenario-card-content {
    flex-direction: column;

    padding: 10px 12px 12px 12px;
}


.scenario-card-title {
    font-size: 14px;
    font-weight: bold;

    color: var(--text-primary);

    margin-bottom: 3px;
}


.scenario-card-category {
    font-size: 11px;

    color: var(--text-secondary);
}


/* ================================================================
   RIGHT : DETAILS PANEL
   ================================================================ */

.scenario-details-container{
    border-left-width: 1px;
    border-left-style: solid;
    border-left-color: var(--border-color);
    flex-shrink: 0;
    width: 36%;
    min-width: 340px;
    max-width: 500px;
    flex-direction: column;
    padding: 12px;
}

.scenario-details {
    width: 36%;
    min-width: 340px;
    max-width: 500px;
    flex-direction: column;
    padding: 12px;
    flex-grow: 1;
    overflow: hidden;
}


/* ================================================================
   DETAILS HEADER
   ================================================================ */

.scenario-details-header {
    flex-direction: row;

    align-items: flex-start;
    justify-content: space-between;

    margin-bottom: 16px;
}


.scenario-details-title-container {
    flex-direction: column;
    flex-grow: 1;
}


.scenario-details-title {
    font-size: 22px;
    font-weight: bold;

    color: var(--text-primary);

    margin-bottom: 3px;
}


.scenario-details-category {
    font-size: 12px;

    color: var(--text-secondary);
}


.scenario-more-button {
    width: 34px;
    height: 34px;

    padding: 0;

    background-color: transparent;

    border-width: 1px;
    border-style: solid;
    border-color: var(--border-color);

    border-radius: 6px;

    color: var(--text-secondary);

    font-size: 14px;
}


.scenario-more-button:hover {
    background-color: var(--button-hover);
    color: var(--text-primary);
}


/* ================================================================
   DETAILS PREVIEW
   ================================================================ */

.scenario-details-preview {
    width: 100%;
    height: 210px;

    flex-shrink: 0;

    background-color: var(--bg-secondary);

    border-radius: 10px;

    border-width: 1px;
    border-style: solid;
    border-color: var(--border-color);

    overflow: hidden;

    margin-bottom: 22px;
}


.scenario-details-preview-image {
    width: 100%;
    height: 100%;

    -unity-scale-mode: scale-and-crop;
}


/* ================================================================
   DETAILS SECTIONS
   ================================================================ */

.scenario-details-section {
    flex-direction: column;

    margin-bottom: 20px;
}


.scenario-section-title {
    font-size: 12px;
    font-weight: bold;

    color: var(--text-primary);

    margin-bottom: 8px;
}


.scenario-description {
    font-size: 13px;

    color: var(--text-secondary);

    white-space: normal;

    line-height: 1.4;
}


/* ================================================================
   INFORMATION GRID
   ================================================================ */

.scenario-info-grid {
    flex-direction: row;
    flex-wrap: wrap;
}


.scenario-info-item {
    width: 50%;

    flex-direction: column;

    margin-bottom: 12px;
}


.scenario-info-label {
    font-size: 11px;

    color: var(--text-secondary);

    margin-bottom: 3px;
}


.scenario-info-value {
    font-size: 13px;

    color: var(--text-primary);
}


/* ================================================================
   TAGS
   ================================================================ */

.scenario-tags {
    flex-direction: row;
    flex-wrap: wrap;
}


.scenario-tag {
    background-color: var(--bg-secondary);

    border-width: 1px;
    border-style: solid;
    border-color: var(--border-color);

    border-radius: 5px;

    padding: 5px 8px;

    margin-right: 6px;
    margin-bottom: 6px;

    font-size: 11px;

    color: var(--text-secondary);
}


/* ================================================================
   DETAILS ACTIONS
   ================================================================ */

.scenario-details-actions {
    flex-direction: row;

    align-items: center;

    padding-top: 14px;

    border-top-width: 1px;
    border-top-style: solid;
    border-top-color: var(--border-color);
}


.scenario-details-actions .action-button {
    width: auto;
    margin-left: 8px;
    padding: 12px 16px;
    font-size: 16px;
    border-radius: 6px;
    color: var(--text-primary);
}

.scenario-details-actions .action-button:last-child {
    margin-right: 0;
}


.scenario-details-actions .action-button.primary {
    background-color: var(--accent);
}

.scenario-details-actions .action-button.primary:hover {
    background-color: var(--accent-soft);
}


.scenario-details-actions .action-button.secondary {
    background-color: transparent;
    border-width: 1px;
    border-style: solid;
    border-color: var(--border-color);
}

.scenario-details-actions .action-button.secondary:hover {
    background-color: var(--button-hover);
}


/* ================================================================
   SCROLLBAR
   ================================================================ */

.scenario-list-view .unity-scroll-view__content-viewport {
    background-color: transparent;
}


.scenario-list-view .unity-scroll-view__content-container {
    background-color: transparent;
}


/* ================================================================
   EMPTY STATE
   ================================================================ */

.scenario-empty-state {
    flex-grow: 1;

    align-items: center;
    justify-content: center;

    padding: 40px;
}


.scenario-empty-state-title {
    font-size: 16px;
    font-weight: bold;

    color: var(--text-primary);

    margin-bottom: 6px;
}


.scenario-empty-state-description {
    font-size: 13px;

    color: var(--text-secondary);

    -unity-text-align: middle-center;
}




.scenario-new-button {
    width: auto;
    min-width: 180px;
    padding: 12px 20px;
    font-size: 14px;
    border-radius: 7px;
}