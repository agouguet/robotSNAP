/* ================================================================
   SCENARIO CREATION VIEW
   ================================================================ */

/* ----------------------------------------------------------------
   MAIN VIEW
   ---------------------------------------------------------------- */

.scenario-creation-view {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    flex-direction: column;

    background-color: var(--bg-primary);

    padding-left: 24px;
    padding-right: 24px;
    padding-top: 20px;
    padding-bottom: 16px;
}


/* ================================================================
   HEADER
   ================================================================ */

.creation-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;

    min-height: 68px;
    padding-bottom: 16px;

    border-bottom-width: 1px;
    border-bottom-style: solid;
    border-bottom-color: var(--border-color);

    flex-shrink: 0;
}


.creation-header-left {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}


.creation-back-button {
    width: 32px;
    height: 32px;

    margin-right: 12px;

    padding: 0;

    background-color: transparent;

    border-width: 0;

    color: var(--text-secondary);

    font-size: 24px;

    -unity-text-align: middle-center;
}


.creation-back-button:hover {
    color: var(--text-primary);
    background-color: var(--button-hover);
}


.creation-title-container {
    flex-direction: column;
}


.creation-title {
    color: var(--text-primary);

    font-size: 22px;
    -unity-font-style: bold;

    margin-bottom: 4px;
}


.creation-subtitle {
    color: var(--text-secondary);

    font-size: 13px;
}


.creation-header-actions {
    flex-direction: row;
    align-items: center;

    flex-shrink: 0;
}


.creation-draft-button {
    height: 40px;

    margin-right: 12px;

    padding-left: 18px;
    padding-right: 18px;
}


.creation-next-button {
    height: 40px;

    padding-left: 20px;
    padding-right: 20px;
}


/* ================================================================
   STEPPER
   ================================================================ */

.creation-stepper {
    flex-direction: row;
    align-items: center;

    height: 52px;

    padding-left: 18px;
    padding-right: 18px;

    flex-shrink: 0;
}


.creation-step {
    flex-direction: row;
    align-items: center;

    flex-shrink: 0;
}


.step-number {
    width: 28px;
    height: 28px;

    border-radius: 14px;

    border-width: 1px;
    border-style: solid;
    border-color: var(--border-color);

    background-color: transparent;

    align-items: center;
    justify-content: center;
}


.step-number Label {
    color: var(--text-secondary);

    font-size: 13px;

    -unity-text-align: middle-center;
}


.step-label {
    margin-left: 8px;

    color: var(--text-secondary);

    font-size: 13px;
}


.creation-step.active .step-number {
    background-color: var(--accent);

    border-color: var(--accent);
}


.creation-step.active .step-number Label {
    color: white;
}


.creation-step.active .step-label {
    color: var(--text-primary);
}


.step-line {
    height: 1px;

    flex-grow: 1;

    min-width: 30px;

    margin-left: 14px;
    margin-right: 14px;

    background-color: var(--border-color);
}


/* ================================================================
   MAIN BODY
   ================================================================ */

.creation-body {
    flex-direction: row;

    flex-grow: 1;

    min-height: 0;

    padding-top: 12px;
    padding-bottom: 12px;

    overflow: hidden;
}


/* ================================================================
   COMMON PANEL
   ================================================================ */

.creation-panel {
    background-color: var(--bg-secondary);

    border-width: 1px;
    border-style: solid;
    border-color: var(--border-color);

    border-radius: 8px;

    padding: 16px;

    flex-shrink: 0;
}


.creation-panel-title {
    color: var(--text-primary);

    font-size: 14px;
    -unity-font-style: bold;

    margin-bottom: 14px;

    flex-shrink: 0;
}


/* ================================================================
   LEFT COLUMN
   ================================================================ */

.general-information-panel {
    width: 300px;

    margin-right: 14px;

    overflow: hidden;
}


.general-information-panel > .creation-field {
    flex-shrink: 0;
}


/* ================================================================
   FORM FIELDS
   ================================================================ */

.creation-field {
    flex-direction: column;

    margin-bottom: 12px;
}


.creation-field-label {
    color: var(--text-primary);

    font-size: 12px;

    margin-bottom: 6px;
}


.creation-text-field,
.creation-dropdown {
    min-height: 36px;

    background-color: var(--bg-primary);

    border-width: 1px;
    border-style: solid;
    border-color: var(--border-color);

    border-radius: 6px;

    color: var(--text-primary);

    font-size: 12px;
}


.creation-text-field:focus,
.creation-dropdown:focus {
    border-color: var(--accent);
}


/* Unity TextField internal input */

.creation-text-field .unity-text-field__input {
    background-color: transparent;

    border-width: 0;

    color: var(--text-primary);

    font-size: 12px;

    padding-left: 8px;
    padding-right: 8px;
}


.creation-textarea {
    min-height: 66px;
    max-height: 66px;

    background-color: var(--bg-primary);

    border-width: 1px;
    border-style: solid;
    border-color: var(--border-color);

    border-radius: 6px;

    color: var(--text-primary);

    font-size: 12px;
}


.creation-textarea .unity-text-field__input {
    background-color: transparent;

    border-width: 0;

    color: var(--text-primary);

    font-size: 12px;

    padding: 8px;
}


.field-counter {
    align-self: flex-end;

    margin-top: 3px;

    color: var(--text-secondary);

    font-size: 9px;
}


/* ================================================================
   TAGS
   ================================================================ */

.selected-tags {
    flex-direction: row;
    flex-wrap: wrap;

    margin-top: 6px;
}


.selected-tags > * {
    margin-right: 4px;
    margin-bottom: 4px;
}


/* ================================================================
   UPLOAD IMAGE
   ================================================================ */

.cover-image-field {
    flex-grow: 1;

    min-height: 120px;

    margin-bottom: 0;
}


.cover-image-drop-zone {
    flex-grow: 1;

    min-height: 105px;

    border-width: 1px;
    border-style: dashed;
    border-color: var(--border-color);

    border-radius: 6px;

    align-items: center;
    justify-content: center;

    background-color: rgba(255, 255, 255, 0.01);
}


.cover-image-drop-zone:hover {
    border-color: var(--accent);

    background-color: rgba(0, 110, 255, 0.04);
}

.map-image-field {
    flex-grow: 1;

    min-height: 120px;

    margin-bottom: 0;
}


.map-image-drop-zone {
    flex-grow: 1;

    min-height: 105px;

    border-width: 1px;
    border-style: dashed;
    border-color: var(--border-color);

    border-radius: 6px;

    align-items: center;
    justify-content: center;

    background-color: rgba(255, 255, 255, 0.01);
}


.map-image-drop-zone:hover {
    border-color: var(--accent);

    background-color: rgba(0, 110, 255, 0.04);
}


.upload-icon {
    width: 28px;
    height: 28px;

    align-items: center;
    justify-content: center;

    margin-bottom: 5px;
}


.upload-icon Label {
    color: var(--text-secondary);

    font-size: 20px;

    -unity-text-align: middle-center;
}


.upload-title {
    color: var(--text-secondary);

    font-size: 10px;
}


.upload-link {
    color: var(--accent);

    font-size: 10px;

    margin-top: 2px;
}


.upload-hint {
    color: var(--text-secondary);

    font-size: 9px;

    margin-top: 7px;
}


/* ================================================================
   CENTER COLUMN
   ================================================================ */

.creation-center-column {
    flex-grow: 1;

    min-width: 400px;
    min-height: 0;

    margin-right: 14px;

    flex-direction: column;
}


/* ================================================================
   ENVIRONMENT PANEL
   ================================================================ */

.environment-preview-panel {
    flex-grow: 1;

    min-height: 300px;

    padding: 0;

    overflow: hidden;
}


.environment-preview-panel > .creation-panel-title {
    padding-left: 16px;
    padding-top: 14px;

    margin-bottom: 10px;
}


/* ================================================================
   ENVIRONMENT TOOLBAR
   ================================================================ */

.environment-toolbar {
    height: 42px;

    flex-direction: row;

    justify-content: space-between;
    align-items: center;

    padding-left: 10px;
    padding-right: 10px;

    border-top-width: 1px;
    border-bottom-width: 1px;

    border-top-style: solid;
    border-bottom-style: solid;

    border-top-color: var(--border-color);
    border-bottom-color: var(--border-color);

    background-color: var(--bg-primary);
}


.environment-tools {
    flex-direction: row;
    align-items: center;
}


.environment-tool {
    width: 30px;
    height: 30px;

    margin-right: 3px;

    padding: 0;

    background-color: transparent;

    border-width: 0;

    border-radius: 5px;

    color: var(--text-secondary);

    font-size: 15px;

    -unity-text-align: middle-center;
}


.environment-tool:hover {
    color: var(--text-primary);

    background-color: var(--button-hover);
}


.environment-tool.selected {
    color: white;

    background-color: var(--accent);
}


.toolbar-separator {
    width: 1px;
    height: 20px;

    margin-left: 5px;
    margin-right: 5px;

    background-color: var(--border-color);
}


.environment-view-mode {
    flex-direction: row;
    align-items: center;

    border-width: 1px;
    border-style: solid;
    border-color: var(--border-color);

    border-radius: 5px;

    overflow: hidden;
}


.view-mode-button {
    width: 36px;
    height: 28px;

    padding: 0;

    background-color: transparent;

    border-width: 0;

    color: var(--text-secondary);

    font-size: 10px;

    -unity-text-align: middle-center;
}


.view-mode-button:hover {
    background-color: var(--button-hover);
}


.view-mode-button.selected {
    background-color: var(--accent);

    color: white;
}


/* ================================================================
   ENVIRONMENT CANVAS
   ================================================================ */

.environment-canvas {
    flex-grow: 1;

    min-height: 0;

    position: relative;

    background-color: #101820;

    overflow: hidden;
}


.environment-image {
    position: absolute;

    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    width: 100%;
    height: 100%;

    -unity-background-scale-mode: scale-and-crop;
}


.environment-overlay {
    position: absolute;

    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}


.robot-marker {
    position: absolute;

    width: 18px;
    height: 18px;

    border-radius: 9px;

    background-color: rgb(55, 220, 125);

    border-width: 2px;
    border-style: solid;
    border-color: rgb(10, 30, 20);
}


.goal-marker {
    position: absolute;

    width: 18px;
    height: 18px;

    border-radius: 9px;

    background-color: var(--accent);

    border-width: 2px;
    border-style: solid;
    border-color: rgb(10, 30, 50);
}


/* ================================================================
   ENVIRONMENT FOOTER
   ================================================================ */

.environment-footer {
    min-height: 68px;

    flex-direction: row;

    justify-content: space-between;
    align-items: center;

    padding-left: 16px;
    padding-right: 16px;

    border-top-width: 1px;
    border-top-style: solid;
    border-top-color: var(--border-color);

    background-color: var(--bg-secondary);
}


.environment-metadata {
    flex-direction: row;

    align-items: center;
}


.environment-metadata-item {
    min-width: 110px;

    margin-right: 28px;

    flex-direction: column;
}


.metadata-label {
    color: var(--text-secondary);

    font-size: 10px;

    margin-bottom: 4px;
}


.metadata-value {
    color: var(--text-primary);

    font-size: 11px;
}

/* ================================================================
   RIGHT COLUMN
   ================================================================ */

.creation-summary-column {
    width: 300px;

    min-width: 270px;
    min-height: 0;

    flex-direction: column;

    overflow: hidden;
}


/* ================================================================
   SUMMARY PANELS
   ================================================================ */

.summary-panel {
    padding: 15px;

    margin-bottom: 12px;
}


.summary-panel .creation-panel-title {
    margin-bottom: 10px;
}


.summary-row {
    min-height: 30px;

    flex-direction: row;

    justify-content: space-between;
    align-items: center;

    border-bottom-width: 1px;
    border-bottom-style: solid;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}


.summary-row.last {
    border-bottom-width: 0;
}


.summary-label {
    color: var(--text-secondary);

    font-size: 11px;
}


.summary-value {
    color: var(--text-primary);

    font-size: 11px;

    -unity-text-align: middle-right;
}


/* ================================================================
   AGENT SUMMARY
   ================================================================ */

.summary-panel-header {
    flex-direction: row;

    justify-content: flex-start;
    align-items: center;
}


.summary-panel-header .creation-panel-title {
    margin-bottom: 10px;
}


.info-icon {
    color: var(--text-secondary);

    font-size: 10px;

    margin-left: 6px;
}


.agent-summary-row {
    min-height: 32px;

    flex-direction: row;

    align-items: center;

    border-bottom-width: 1px;
    border-bottom-style: solid;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}


.agent-summary-name {
    flex-direction: row;

    align-items: center;

    flex-grow: 1;
}


.agent-status-dot {
    width: 9px;
    height: 9px;

    border-radius: 5px;

    margin-right: 8px;
}


.robot-dot {
    background-color: rgb(80, 220, 125);
}


.pedestrian-dot {
    background-color: rgb(55, 145, 240);
}


.agent-summary-row .summary-value {
    width: 28px;

    margin-right: 12px;
}


.summary-action {
    width: 52px;

    color: var(--accent);

    font-size: 10px;

    -unity-text-align: middle-right;
}


.summary-total-row {
    flex-direction: row;

    justify-content: space-between;
    align-items: center;

    margin-top: 8px;
}


/* ================================================================
   OBJECTIVES
   ================================================================ */

.objective-summary-row {
    min-height: 34px;

    flex-direction: row;

    align-items: center;
}


.objective-name {
    flex-grow: 1;

    flex-direction: row;

    align-items: center;
}


.objective-dot {
    width: 9px;
    height: 9px;

    border-radius: 5px;

    margin-right: 8px;
}


.primary-objective-dot {
    background-color: rgb(235, 150, 40);
}


.interest-objective-dot {
    background-color: rgb(145, 80, 220);
}


.objective-summary-row .summary-value {
    width: 25px;

    margin-right: 12px;
}


/* ================================================================
   FOOTER
   ================================================================ */

.creation-footer {
    min-height: 52px;

    flex-direction: row;

    justify-content: space-between;
    align-items: center;

    padding-top: 10px;

    border-top-width: 1px;
    border-top-style: solid;
    border-top-color: var(--border-color);

    flex-shrink: 0;
}


.creation-cancel-button {
    min-width: 120px;

    height: 38px;
}


.creation-save-button {
    min-width: 120px;

    height: 38px;
}