<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="project://database/Assets/UI/Tabs/Scenarios/uss/ScenarioCreationTab.uss" />
    <ui:VisualElement name="ScenarioEditorView" class="scenario-creation-view">
        <ui:VisualElement class="creation-header"><ui:VisualElement class="creation-header-left"><ui:Button name="BackToScenariosButton" text="‹" class="creation-back-button" /><ui:VisualElement><ui:Label text="Créer un scénario" class="scenario-page-title" /><ui:Label text="Carte, parcours du robot et groupe de piétons." class="scenario-page-subtitle" /></ui:VisualElement></ui:VisualElement></ui:VisualElement>
        <ui:VisualElement class="creation-body">
            <ui:VisualElement class="creation-panel general-information-panel"><ui:Label text="Informations" class="creation-panel-title" /><ui:TextField name="NameField" label="Nom *" class="creation-text-field" /><ui:TextField name="DescriptionField" label="Description" multiline="true" class="creation-textarea" /><ui:TextField name="TagsField" label="Tags" class="creation-text-field" /><ui:DropdownField name="MapDropdown" label="Carte *" class="creation-dropdown" /><ui:DropdownField name="PreviewDropdown" label="Aperçu" class="creation-dropdown" /><ui:FloatField name="DurationField" label="Durée (s)" class="creation-text-field" /></ui:VisualElement>
            <ui:VisualElement class="creation-panel creation-form-panel"><ui:Label text="Robot" class="creation-panel-title" /><ui:FloatField name="StartXField" label="Départ X" /><ui:FloatField name="StartZField" label="Départ Z" /><ui:FloatField name="StartYawField" label="Yaw" /><ui:FloatField name="GoalXField" label="Objectif X" /><ui:FloatField name="GoalZField" label="Objectif Z" /><ui:Label text="Piétons" class="creation-panel-title" /><ui:IntegerField name="HumanCountField" label="Nombre" /><ui:DropdownField name="BehaviorDropdown" label="Comportement" class="creation-dropdown" /><ui:Label text="Validation" class="creation-panel-title" /><ui:Label name="ScenarioSummaryLabel" class="scenario-summary-label" /><ui:Label name="ValidationLabel" class="scenario-validation-label" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="creation-footer"><ui:Button name="SaveEditorButton" text="Créer le scénario" class="action-button primary creation-save-button" /></ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
