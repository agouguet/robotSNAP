<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/Tabs/Scenarios/uss/ScenarioCreationTab.uss?fileID=7433441132597879392&amp;guid=75c4c03faf2f9d48f9a09a9a9d02951e&amp;type=3"/>
    <ui:VisualElement name="CreationRoot" class="creation-root">
        <ui:VisualElement name="CreationHeader" class="creation-header">
            <ui:VisualElement class="creation-header-left">
                <ui:Button name="BackToScenariosButton" text="‹" class="creation-back-button"/>
                <ui:VisualElement class="scenario-header-content">
                    <ui:Label name="EditorTitle" text="New scenario" class="scenario-page-title"/>
                    <ui:Label name="EditorSubtitle" text="Create and configure a new simulation scenario." class="scenario-page-subtitle"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="CreationStepper" class="creation-stepper">
            <ui:VisualElement name="Step1" class="creation-step active">
                <ui:VisualElement class="step-number">
                    <ui:Label text="1"/>
                </ui:VisualElement>
                <ui:Label text="Information &amp; Environment" class="step-label"/>
            </ui:VisualElement>
            <ui:VisualElement name="StepLine1" class="step-line"/>
            <ui:VisualElement name="Step2" class="creation-step">
                <ui:VisualElement class="step-number">
                    <ui:Label text="2"/>
                </ui:VisualElement>
                <ui:Label text="Agents &amp; Behaviors" class="step-label"/>
            </ui:VisualElement>
            <ui:VisualElement name="StepLine2" class="step-line"/>
            <ui:VisualElement name="Step3" class="creation-step">
                <ui:VisualElement class="step-number">
                    <ui:Label text="3"/>
                </ui:VisualElement>
                <ui:Label text="Validation" class="step-label"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="Step1Content" class="creation-body creation-step-content">
            <ui:VisualElement name="GeneralInformationPanel" class="creation-panel general-information-panel">
                <ui:Label text="General information" class="creation-panel-title"/>
                <ui:VisualElement class="creation-field">
                    <ui:Label text="Scenario name *" class="creation-field-label"/>
                    <ui:TextField name="NameField" placeholder="E.g. Lobby - Rush hour" max-length="60" class="creation-text-field"/>
                    <ui:Label name="NameCounter" text="0/60" class="field-counter"/>
                </ui:VisualElement>
                <ui:VisualElement class="creation-field map-image-field">
                    <ui:Label text="Scenario environment *" class="creation-field-label"/>
                    <ui:VisualElement name="MapImageDropZone" class="map-image-drop-zone">
                        <ui:Label text="OCCUPANCY GRID" class="upload-title"/>
                        <ui:DropdownField name="MapDropdown" class="creation-step-hidden"/>
                        <ui:Label name="SelectedMapLabel" text="No environment selected" class="selected-map-label"/>
                        <ui:VisualElement class="environment-choice-actions">
                            <ui:Button name="OpenMapBrowserButton" text="Browse library" class="environment-choice-button primary-choice"/>
                            <ui:Button name="OpenEnvironmentImportButton" text="Import image" class="environment-choice-button"/>
                        </ui:VisualElement>
                        <ui:Label text="Organized by dataset and map name" class="upload-hint"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="creation-field">
                    <ui:Label text="Description" class="creation-field-label"/>
                    <ui:TextField name="DescriptionField" multiline="true" placeholder="Describe the context, purpose and special features of this scenario..." max-length="300" class="creation-textarea"/>
                    <ui:Label name="DescriptionCounter" text="0/300" class="field-counter"/>
                </ui:VisualElement>
                <ui:VisualElement class="creation-field">
                    <ui:Label text="Tags" class="creation-field-label"/>
                    <ui:DropdownField name="TagsDropdown" class="creation-dropdown"/>
                    <ui:VisualElement class="tag-entry-row">
                        <ui:TextField name="TagInputField" placeholder="New tag" class="creation-text-field tag-input"/>
                        <ui:Button name="AddTagButton" text="+" class="tag-add-button"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="SelectedTags" class="selected-tags"/>
                </ui:VisualElement>
                <ui:VisualElement class="creation-field cover-image-field">
                    <ui:Label text="Cover image" class="creation-field-label"/>
                    <ui:VisualElement name="CoverImageDropZone" class="cover-image-drop-zone">
                        <ui:Image name="CoverPreviewImage" class="cover-preview-image"/>
                        <ui:VisualElement class="cover-preview-controls">
                            <ui:Button name="UseDefaultCoverButton" text="Use default" class="cover-choice-button active"/>
                            <ui:Button name="BrowseCoverImageButton" text="Import image" class="cover-choice-button"/>
                        </ui:VisualElement>
                        <ui:DropdownField name="PreviewDropdown" class="creation-step-hidden"/>
                        <ui:Label name="CoverImageStatusLabel" text="Default 16:9 cover" class="upload-hint"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="EnvironmentColumn" class="creation-center-column">
                <ui:VisualElement name="EnvironmentPreviewPanel" class="creation-panel environment-preview-panel">
                    <ui:Label text="Environment preview" class="creation-panel-title"/>
                    <ui:VisualElement name="EnvironmentCanvas" class="environment-canvas">
                        <ui:Image name="EnvironmentImage" class="environment-image"/>
                        <ui:Label name="EnvironmentPlaceholder" text="Select an environment to preview its occupancy grid." class="environment-placeholder"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="EnvironmentFooter" class="environment-footer">
                        <ui:VisualElement class="environment-metadata">
                            <ui:VisualElement class="environment-metadata-item">
                                <ui:Label text="Map" class="metadata-label"/>
                                <ui:Label name="MapName" text="—" class="metadata-value"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="environment-metadata-item">
                                <ui:Label text="Image" class="metadata-label"/>
                                <ui:Label name="MapPointCount" text="—" class="metadata-value"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="environment-metadata-item">
                                <ui:Label text="World bounds" class="metadata-label"/>
                                <ui:Label name="MapMode" text="—" class="metadata-value"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label text="Routes and exact positions are configured in step 2." class="environment-footer-hint"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="Step2Content" class="creation-body creation-step-content agents-step-layout creation-step-hidden">
            <ui:VisualElement class="creation-panel agent-settings-panel">
                <ui:ScrollView class="agent-settings-scroll">
                    <ui:Label text="Route editor" class="creation-panel-title"/>
                    <ui:VisualElement class="creation-field">
                        <ui:Label text="Active route" class="creation-field-label"/>
                        <ui:DropdownField name="RouteSelectorDropdown" class="creation-dropdown"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="route-management-actions">
                        <ui:Button name="AddHumanRouteButton" text="+ Human route" class="route-management-button"/>
                        <ui:Button name="RemoveHumanRouteButton" text="Remove" class="route-management-button danger-subtle"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="agent-panel-divider"/>
                    <ui:VisualElement class="config-panel-heading">
                        <ui:VisualElement class="agent-status-dot robot-dot"/>
                        <ui:VisualElement>
                            <ui:Label text="Robot settings" class="creation-panel-title compact-title"/>
                            <ui:Label text="Applied to the robot route" class="config-panel-subtitle"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="creation-field">
                        <ui:Label text="Robot type" class="creation-field-label"/>
                        <ui:DropdownField name="RobotTypeDropdown" class="creation-dropdown"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="creation-field">
                        <ui:Label text="Behavior" class="creation-field-label"/>
                        <ui:DropdownField name="RobotBehaviorDropdown" class="creation-dropdown"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="coordinate-row">
                        <ui:VisualElement class="creation-field half-field">
                            <ui:Label text="Speed (m/s) *" class="creation-field-label"/>
                            <ui:FloatField name="RobotSpeedField" class="creation-text-field"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="creation-field half-field field-row-right">
                            <ui:Label text="Duration (s)" class="creation-field-label"/>
                            <ui:FloatField name="DurationField" class="creation-text-field"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="creation-field">
                        <ui:Label text="Start orientation Y (degrees)" class="creation-field-label"/>
                        <ui:FloatField name="StartYawField" class="creation-text-field"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="HumanRouteSettings" class="route-editor-hidden">
                        <ui:VisualElement class="agent-panel-divider"/>
                        <ui:VisualElement class="config-panel-heading human-heading">
                            <ui:VisualElement class="agent-status-dot pedestrian-dot"/>
                            <ui:VisualElement>
                                <ui:Label text="Human route settings" class="creation-panel-title compact-title"/>
                                <ui:Label text="Agents sharing this ordered route" class="config-panel-subtitle"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="coordinate-row">
                            <ui:VisualElement class="creation-field half-field">
                                <ui:Label text="Agent count" class="creation-field-label"/>
                                <ui:IntegerField name="HumanCountField" class="creation-text-field"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="creation-field half-field field-row-right">
                                <ui:Label text="Speed (m/s)" class="creation-field-label"/>
                                <ui:FloatField name="HumanSpeedField" class="creation-text-field"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="creation-field">
                            <ui:Label text="Behavior" class="creation-field-label"/>
                            <ui:DropdownField name="HumanBehaviorDropdown" class="creation-dropdown"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="creation-field">
                            <ui:Label text="Movement controller" class="creation-field-label"/>
                            <ui:DropdownField name="MovementControllerDropdown" class="creation-dropdown"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>

            <ui:VisualElement class="creation-panel agents-map-panel">
                <ui:VisualElement class="agents-map-heading">
                    <ui:VisualElement>
                        <ui:Label text="Interactive route map" class="creation-panel-title compact-title"/>
                        <ui:Label name="PlacementInstructionLabel" text="Select a route point, then click the map." class="config-panel-subtitle"/>
                    </ui:VisualElement>
                    <ui:Label name="MapCursorCoordinatesLabel" text="X —  Z —" class="map-cursor-coordinates"/>
                </ui:VisualElement>
                <ui:VisualElement class="placement-toolbar">
                    <ui:Button name="SetRouteStartButton" text="Place start" class="placement-tool"/>
                    <ui:Button name="AddRouteObjectiveButton" text="+ Add objective" class="placement-tool primary-placement-tool"/>
                    <ui:Button name="ToggleMapGridButton" text="Grid &amp; scale" class="placement-tool active"/>
                </ui:VisualElement>
                <ui:VisualElement name="AgentsEnvironmentCanvas" class="agents-environment-canvas">
                    <ui:Image name="AgentsEnvironmentImage" class="agents-environment-image"/>
                    <ui:VisualElement name="RouteOverlayHost" picking-mode="Ignore" class="route-overlay-host"/>
                    <ui:Label name="AgentsMapPlaceholder" text="Select an environment in step 1 first." class="environment-placeholder"/>
                </ui:VisualElement>
                <ui:VisualElement class="map-legend">
                    <ui:Label text="○ Start  →  ● Objectives" class="legend-robot-start"/>
                    <ui:Label name="ActiveRouteLabel" text="Robot route" class="active-route-label"/>
                    <ui:Label name="GridScaleLabel" text="Grid and scale: 1 m" class="grid-scale-label"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="creation-panel manual-coordinates-panel">
                <ui:ScrollView class="manual-coordinates-scroll">
                    <ui:Label text="Route points" class="creation-panel-title"/>
                    <ui:Label text="Manual coordinates, ordering and map placement stay synchronized." class="config-panel-subtitle route-subtitle"/>
                    <ui:VisualElement name="RoutePointsContainer" class="route-points-container"/>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="Step3Content" class="creation-body creation-step-content validation-layout creation-step-hidden">
            <ui:VisualElement name="CreationSummaryColumn" class="creation-summary-column">
                <ui:VisualElement name="ScenarioSummaryPanel" class="creation-panel summary-panel">
                    <ui:Label text="Scenario summary" class="creation-panel-title"/>
                    <ui:VisualElement class="summary-row">
                        <ui:Label text="Name" class="summary-label"/>
                        <ui:Label name="SummaryName" text="Not set" class="summary-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="summary-row">
                        <ui:Label text="Type" class="summary-label"/>
                        <ui:Label name="SummaryType" text="Custom" class="summary-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="summary-row">
                        <ui:Label text="Environment" class="summary-label"/>
                        <ui:Label name="SummaryEnvironment" text="Not set" class="summary-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="summary-row">
                        <ui:Label text="Agents" class="summary-label"/>
                        <ui:Label name="SummaryAgents" text="1" class="summary-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="summary-row">
                        <ui:Label text="Objectives" class="summary-label"/>
                        <ui:Label name="SummaryObjectives" text="1" class="summary-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="summary-row last">
                        <ui:Label text="Maximum duration" class="summary-label"/>
                        <ui:Label name="SummaryDuration" text="Unlimited" class="summary-value"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="AgentsSummaryPanel" class="creation-panel summary-panel">
                    <ui:Label text="Configured agents" class="creation-panel-title"/>
                    <ui:VisualElement class="agent-summary-row">
                        <ui:VisualElement class="agent-summary-name">
                            <ui:VisualElement class="agent-status-dot robot-dot"/>
                            <ui:Label text="Robot" class="summary-label"/>
                        </ui:VisualElement>
                        <ui:Label name="RobotCount" text="1" class="summary-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="agent-summary-row">
                        <ui:VisualElement class="agent-summary-name">
                            <ui:VisualElement class="agent-status-dot pedestrian-dot"/>
                            <ui:Label text="Humans" class="summary-label"/>
                        </ui:VisualElement>
                        <ui:Label name="PedestrianCount" text="0" class="summary-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="summary-total-row">
                        <ui:Label text="Total" class="summary-label"/>
                        <ui:Label name="TotalAgentCount" text="1" class="summary-value"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="creation-panel validation-panel">
                <ui:VisualElement class="validation-heading">
                    <ui:VisualElement name="ValidationStatusIcon" class="validation-status-icon"/>
                    <ui:VisualElement>
                        <ui:Label text="Final review" class="validation-title"/>
                        <ui:Label text="Review the settings before saving the YAML file." class="config-panel-subtitle"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="ValidationLabel" text="" class="validation-message"/>
                <ui:VisualElement class="review-grid">
                    <ui:VisualElement class="review-card">
                        <ui:Label text="ROBOT" class="review-eyebrow"/>
                        <ui:Label name="SummaryRobotConfig" text="—" class="review-main-value"/>
                        <ui:Label name="SummaryRobotRoute" text="—" class="review-secondary-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="review-card review-card-right">
                        <ui:Label text="HUMANS" class="review-eyebrow"/>
                        <ui:Label name="SummaryHumanConfig" text="No humans" class="review-main-value"/>
                        <ui:Label name="SummaryHumanRoute" text="—" class="review-secondary-value"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="review-description-card">
                    <ui:Label text="DESCRIPTION" class="review-eyebrow"/>
                    <ui:Label name="SummaryDescription" text="No description." class="review-description"/>
                </ui:VisualElement>
                <ui:VisualElement class="validation-check-list">
                    <ui:Label name="CheckInformation" text="✓ General information complete" class="validation-check"/>
                    <ui:Label name="CheckEnvironment" text="✓ Environment selected" class="validation-check"/>
                    <ui:Label name="CheckRoute" text="✓ Agent routes valid" class="validation-check"/>
                    <ui:Label name="CheckHumans" text="✓ Human route configuration valid" class="validation-check"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="CreationFooter" class="creation-footer">
            <ui:Button name="CancelEditorButton" text="Cancel" class="action-button secondary creation-cancel-button"/>
            <ui:Label name="EditorFeedbackLabel" text="" class="editor-feedback"/>
            <ui:VisualElement class="creation-footer-actions">
                <ui:Button name="PreviousStepButton" text="←   Previous" class="action-button secondary creation-previous-button creation-step-hidden"/>
                <ui:Button name="NextStepButton" text="Next   →" class="action-button primary creation-save-button"/>
                <ui:Button name="SaveEditorButton" text="Save scenario" class="action-button primary creation-save-button creation-step-hidden"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="MapBrowserOverlay" class="creation-modal-overlay creation-step-hidden">
            <ui:VisualElement class="creation-modal map-browser-modal">
                <ui:VisualElement class="modal-heading-row">
                    <ui:VisualElement>
                        <ui:Label text="Environment library" class="creation-modal-title"/>
                        <ui:Label text="Browse occupancy grids by dataset or search by map name." class="creation-modal-subtitle"/>
                    </ui:VisualElement>
                    <ui:Button name="CloseMapBrowserButton" text="×" class="modal-close-button"/>
                </ui:VisualElement>
                <ui:TextField name="MapSearchField" placeholder="Search environments..." class="creation-text-field map-browser-search"/>
                <ui:VisualElement class="map-browser-content">
                    <ui:VisualElement class="map-browser-datasets-panel">
                        <ui:Label text="DATASETS" class="browser-section-title"/>
                        <ui:ScrollView><ui:VisualElement name="MapDatasetList" class="map-dataset-list"/></ui:ScrollView>
                    </ui:VisualElement>
                    <ui:VisualElement class="map-browser-files-panel">
                        <ui:Label name="MapBrowserFolderLabel" text="All environments" class="browser-section-title"/>
                        <ui:ScrollView><ui:VisualElement name="MapFileList" class="map-file-list"/></ui:ScrollView>
                    </ui:VisualElement>
                    <ui:VisualElement class="map-browser-preview-panel">
                        <ui:Image name="MapBrowserPreviewImage" class="map-browser-preview-image"/>
                        <ui:Label name="MapBrowserSelectionLabel" text="Select a map to preview it" class="map-browser-selection-label"/>
                        <ui:Label name="MapBrowserMetadataLabel" text="" class="map-browser-metadata-label"/>
                        <ui:Button name="ConfirmMapSelectionButton" text="Use this environment" class="action-button primary map-browser-confirm"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="EnvironmentImportOverlay" class="creation-modal-overlay creation-step-hidden">
            <ui:VisualElement class="creation-modal import-environment-modal">
                <ui:Label text="Import occupancy grid" class="creation-modal-title"/>
                <ui:Label text="The image is normalized to PNG and stored with metric metadata." class="creation-modal-subtitle"/>
                <ui:VisualElement class="import-modal-content">
                    <ui:VisualElement class="import-preview-panel">
                        <ui:Image name="EnvironmentImportPreviewImage" class="import-preview-image"/>
                        <ui:Label name="EnvironmentImportPreviewPlaceholder" text="Choose a PNG, JPG or JPEG file to preview the grid." class="import-preview-placeholder"/>
                        <ui:Label name="EnvironmentImportDimensionsLabel" text="No image selected" class="import-preview-dimensions"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="import-form-panel">
                        <ui:VisualElement class="creation-field">
                            <ui:Label text="PNG, JPG or JPEG file *" class="creation-field-label"/>
                            <ui:VisualElement class="import-file-row">
                                <ui:TextField name="EnvironmentImportPathField" placeholder="Image file path" class="creation-text-field import-path-field"/>
                                <ui:Button name="BrowseEnvironmentFileButton" text="Browse..." class="action-button secondary import-browse-button"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="creation-field">
                            <ui:Label text="Environment name" class="creation-field-label"/>
                            <ui:TextField name="EnvironmentImportNameField" placeholder="E.g. ground_floor_lab" class="creation-text-field"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="import-metadata-row">
                            <ui:VisualElement class="creation-field import-metadata-field"><ui:Label text="Resolution (m/pixel) *" class="creation-field-label"/><ui:FloatField name="EnvironmentResolutionField" class="creation-text-field"/></ui:VisualElement>
                            <ui:VisualElement class="creation-field import-metadata-field import-field-middle"><ui:Label text="Origin X (m)" class="creation-field-label"/><ui:FloatField name="EnvironmentOriginXField" class="creation-text-field"/></ui:VisualElement>
                            <ui:VisualElement class="creation-field import-metadata-field import-field-middle"><ui:Label text="Origin Z (m)" class="creation-field-label"/><ui:FloatField name="EnvironmentOriginZField" class="creation-text-field"/></ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label name="EnvironmentImportFeedbackLabel" text="" class="import-feedback"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="creation-modal-actions">
                    <ui:Button name="CancelEnvironmentImportButton" text="Cancel" class="action-button secondary"/>
                    <ui:Button name="ConfirmEnvironmentImportButton" text="Import environment" class="action-button primary"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
