<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Tabs/Scenarios/uss/ScenarioCreationTab.uss?fileID=7433441132597879392&amp;guid=75c4c03faf2f9d48f9a09a9a9d02951e&amp;type=3#ScenarioCreationTab"/>
    <ui:VisualElement name="CreationHeader" class="creation-header">
        <ui:VisualElement class="creation-header-left">
            <ui:Button name="BackToScenariosButton" text="‹" class="creation-back-button"/>
            <ui:VisualElement class="scenario-header-content">
                <ui:Label name="EditorTitle" text="Nouveau scénario" class="scenario-page-title"/>
                <ui:Label name="EditorSubtitle" text="Créez et configurez un nouveau scénario de simulation." class="scenario-page-subtitle"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="CreationStepper" class="creation-stepper">
        <ui:VisualElement name="Step1" class="creation-step active">
            <ui:VisualElement class="step-number">
                <ui:Label text="1" style="align-self: center; align-items: center; align-content: center; width: 100%;"/>
            </ui:VisualElement>
            <ui:Label text="Informations &amp; Environnement" class="step-label"/>
        </ui:VisualElement>
        <ui:VisualElement class="step-line"/>
        <ui:VisualElement name="Step2" class="creation-step">
            <ui:VisualElement class="step-number">
                <ui:Label text="2"/>
            </ui:VisualElement>
            <ui:Label text="Agents &amp; Behaviors" class="step-label"/>
        </ui:VisualElement>
        <ui:VisualElement class="step-line"/>
        <ui:VisualElement name="Step3" class="creation-step">
            <ui:VisualElement class="step-number">
                <ui:Label text="3"/>
            </ui:VisualElement>
            <ui:Label text="Validation" class="step-label"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="CreationBody" class="creation-body">
        <ui:VisualElement name="GeneralInformationPanel" class="creation-panel general-information-panel">
            <ui:Label text="General Information" class="creation-panel-title"/>
            <ui:VisualElement class="creation-field">
                <ui:Label text="Scenario Name *" class="creation-field-label"/>
                <ui:TextField name="NameField" placeholder="Ex. : Hall d&apos;entrée - Heure de pointe" class="creation-text-field"/>
                <ui:Label name="NameCounter" text="0/60" class="field-counter"/>
            </ui:VisualElement>
            <ui:VisualElement class="creation-field map-image-field">
                <ui:Label text="Scenario Environment *" class="creation-field-label"/>
                <ui:VisualElement name="MapImageDropZone" class="map-image-drop-zone">
                    <ui:Label text="Choose one map" class="upload-link"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="creation-field">
                <ui:Label text="Description" class="creation-field-label"/>
                <ui:TextField name="DescriptionField" multiline="true" placeholder="Décrivez le contexte, le but et les particularités de ce scénario..." class="creation-textarea"/>
                <ui:Label name="DescriptionCounter" text="0/300" class="field-counter"/>
            </ui:VisualElement>
            <ui:VisualElement class="creation-field">
                <ui:Label text="Tags" class="creation-field-label"/>
                <ui:DropdownField name="TagsDropdown" choices="Ajouter un tag..." value="Ajouter un tag..." class="creation-dropdown"/>
                <ui:VisualElement name="SelectedTags" class="selected-tags"/>
            </ui:VisualElement>
            <ui:VisualElement class="creation-field cover-image-field">
                <ui:Label text="Cover Image" class="creation-field-label"/>
                <ui:VisualElement name="CoverImageDropZone" class="cover-image-drop-zone">
                    <ui:VisualElement class="upload-icon">
                        <ui:Label text="⇧"/>
                    </ui:VisualElement>
                    <ui:Label text="Drag and drop an image here" class="upload-title"/>
                    <ui:Label text="or click to browse" class="upload-link"/>
                    <ui:Label text="Recommended format : 16:9 (1280×720)" class="upload-hint"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="EnvironmentColumn" class="creation-center-column">
            <ui:VisualElement name="EnvironmentPreviewPanel" class="creation-panel environment-preview-panel">
                <ui:Label text="Environment Preview" class="creation-panel-title"/>
                <ui:VisualElement name="EnvironmentToolbar" class="environment-toolbar">
                    <ui:VisualElement name="EnvironmentTools" class="environment-tools">
                        <ui:Button name="SelectToolButton" text="↖" class="environment-tool selected"/>
                        <ui:Button name="PointToolButton" text="○" class="environment-tool"/>
                        <ui:Button name="CircleToolButton" text="○" class="environment-tool"/>
                        <ui:Button name="AreaToolButton" text="□" class="environment-tool"/>
                        <ui:Button name="DeleteToolButton" text="♢" class="environment-tool"/>
                        <ui:VisualElement class="toolbar-separator"/>
                        <ui:Button name="UndoButton" text="↶" class="environment-tool"/>
                        <ui:Button name="RedoButton" text="↷" class="environment-tool"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="EnvironmentViewMode" class="environment-view-mode">
                        <ui:Button name="View2DButton" text="2D" class="view-mode-button selected"/>
                        <ui:Button name="View3DButton" text="3D" class="view-mode-button"/>
                        <ui:Button name="GridButton" text="▦" class="view-mode-button"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="EnvironmentCanvas" class="environment-canvas">
                    <ui:Image name="EnvironmentImage" class="environment-image"/>
                    <ui:VisualElement name="EnvironmentOverlay" class="environment-overlay"/>
                    <ui:VisualElement name="RobotMarker" class="robot-marker" style="display: none;"/>
                    <ui:VisualElement name="GoalMarker" class="goal-marker" style="display: none;"/>
                </ui:VisualElement>
                <ui:VisualElement name="EnvironmentFooter" class="environment-footer">
                    <ui:VisualElement class="environment-metadata">
                        <ui:VisualElement class="environment-metadata-item">
                            <ui:Label text="Dimensions" class="metadata-label"/>
                            <ui:Label name="MapDimensions" text="—" class="metadata-value"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="environment-metadata-item">
                            <ui:Label text="Résolution" class="metadata-label"/>
                            <ui:Label name="MapResolution" text="—" class="metadata-value"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="environment-metadata-item">
                            <ui:Label text="Surface navigable" class="metadata-label"/>
                            <ui:Label name="MapArea" text="—" class="metadata-value"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Button name="ModifyEnvironmentButton" text="×  Modifier l&apos;environnement" class="action-button secondary environment-modify-button"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="CreationSummaryColumn" class="creation-summary-column" style="display: none;">
            <ui:VisualElement name="ScenarioSummaryPanel" class="creation-panel summary-panel">
                <ui:Label text="Résumé du scénario" class="creation-panel-title"/>
                <ui:VisualElement class="summary-row">
                    <ui:Label text="Nom" class="summary-label"/>
                    <ui:Label name="SummaryName" text="Non défini" class="summary-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="summary-row">
                    <ui:Label text="Type" class="summary-label"/>
                    <ui:Label name="SummaryType" text="Non défini" class="summary-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="summary-row">
                    <ui:Label text="Environnement" class="summary-label"/>
                    <ui:Label name="SummaryEnvironment" text="Non défini" class="summary-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="summary-row">
                    <ui:Label text="Agents" class="summary-label"/>
                    <ui:Label name="SummaryAgents" text="0" class="summary-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="summary-row">
                    <ui:Label text="Objectifs" class="summary-label"/>
                    <ui:Label name="SummaryObjectives" text="0" class="summary-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="summary-row last">
                    <ui:Label text="Durée estimée" class="summary-label"/>
                    <ui:Label name="SummaryDuration" text="--:--" class="summary-value"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="AgentsSummaryPanel" class="creation-panel summary-panel">
                <ui:VisualElement class="summary-panel-header">
                    <ui:Label text="Agents prévus" class="creation-panel-title"/>
                    <ui:Label text="ⓘ" class="info-icon"/>
                </ui:VisualElement>
                <ui:VisualElement class="agent-summary-row">
                    <ui:VisualElement class="agent-summary-name">
                        <ui:VisualElement class="agent-status-dot robot-dot"/>
                        <ui:Label text="Robots" class="summary-label"/>
                    </ui:VisualElement>
                    <ui:Label name="RobotCount" text="1" class="summary-value"/>
                    <ui:Label text="Modifier" class="summary-action"/>
                </ui:VisualElement>
                <ui:VisualElement class="agent-summary-row">
                    <ui:VisualElement class="agent-summary-name">
                        <ui:VisualElement class="agent-status-dot pedestrian-dot"/>
                        <ui:Label text="Piétons" class="summary-label"/>
                    </ui:VisualElement>
                    <ui:Label name="PedestrianCount" text="0" class="summary-value"/>
                    <ui:Label text="Modifier" class="summary-action"/>
                </ui:VisualElement>
                <ui:VisualElement class="summary-total-row">
                    <ui:Label text="Total estimé" class="summary-label"/>
                    <ui:Label name="TotalAgentCount" text="1" class="summary-value"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="ObjectivesSummaryPanel" class="creation-panel summary-panel">
                <ui:VisualElement class="summary-panel-header">
                    <ui:Label text="Objectifs" class="creation-panel-title"/>
                    <ui:Label text="ⓘ" class="info-icon"/>
                </ui:VisualElement>
                <ui:VisualElement class="objective-summary-row">
                    <ui:VisualElement class="objective-name">
                        <ui:VisualElement class="objective-dot primary-objective-dot"/>
                        <ui:Label text="Objectifs principaux" class="summary-label"/>
                    </ui:VisualElement>
                    <ui:Label name="PrimaryObjectiveCount" text="0" class="summary-value"/>
                    <ui:Label name="AddPrimaryObjectiveButton" text="Ajouter" class="summary-action"/>
                </ui:VisualElement>
                <ui:VisualElement class="objective-summary-row">
                    <ui:VisualElement class="objective-name">
                        <ui:VisualElement class="objective-dot interest-objective-dot"/>
                        <ui:Label text="Zones d&apos;intérêt" class="summary-label"/>
                    </ui:VisualElement>
                    <ui:Label name="InterestZoneCount" text="0" class="summary-value"/>
                    <ui:Label name="AddInterestZoneButton" text="Ajouter" class="summary-action"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="CreationFooter" class="creation-footer">
        <ui:Button name="CancelEditorButton" text="Annuler" class="action-button secondary creation-cancel-button"/>
        <ui:Button name="SaveEditorButton" text="Suivant   →" class="action-button primary creation-save-button"/>
    </ui:VisualElement>
</ui:UXML>
