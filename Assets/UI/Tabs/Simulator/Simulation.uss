/* Conteneur général de la top bar */
.top-bar {
    /* background-color: var(--bg-secondary); */
    border-bottom: 1px solid var(--border-color);
}

/* Boutons d’action */
.action-button {
    flex-direction: row;
    align-items: center;
    background-color: var(--button-bg);
    border-radius: 8px;
    padding: 10px 18px;
    margin-left: 12px;
    border-width: 0;
    color: var(--text-primary);
    font-size: 14px;
    transition: background-color 0.1s;
}
.action-button:hover {
    background-color: var(--button-hover);
}

/* Split button container */
.split-button-container {
    flex-direction: row;
    margin-left: 12px;
    border-radius: 8px;
    overflow: hidden;
    background-color: var(--accent);
}

.split-button-primary {
    flex-direction: row;
    align-items: center;
    background-color: var(--accent);
    border-width: 0;
    padding: 10px 16px;
    color: white;
    margin: 0;
}

.split-button-primary Label {
    color: white;
}

.split-button-primary .button-icon {
    -unity-background-image-tint-color: white;
}

.split-button-primary:hover {
    background-color: var(--accent-soft);
}
.split-button-arrow {
    background-color: var(--accent);
    border-width: 0;
    border-left-width: 1px;
    border-left-color: rgba(255,255,255,0.3);
    padding: 10px 12px;
    color: white;
    font-size: 12px;
    margin: 0;
}
.split-button-arrow:hover {
    background-color: var(--accent-soft);
}

.full-screen-button {
    width: 64px;
    height: 64px;
    margin: 16px;
    pointer-events: auto;
    background-size: contain;
    background-color: var(--bg-secondary);
    -unity-background-image-tint-color: var(--icon-tint);
    border-radius: 8px;
}

.view-button {
    background-color: var(--button-bg);
    width: 64px;
    height: 64px;
    margin: 16px;
    border-radius: 8px;
    color: var(--text-primary);
    font-size: 20px;
}

.view-button.active {
    background-color: var(--accent);
    color: #FFFFFF;
}