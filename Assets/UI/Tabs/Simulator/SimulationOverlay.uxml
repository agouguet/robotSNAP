<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement data-source="" class="simulation-overlay" style="flex-grow: 1; position: relative; height: 100%;">
        <ui:VisualElement name="CameraContainer" style="flex-grow: 1; min-height: 0; border-radius: 16px; overflow: hidden;">
            <ui:VisualElement name="VisualElement" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; flex-direction: column; justify-content: space-between; align-items: flex-end; pointer-events: none; height: 100%;">
                <ui:VisualElement style="position: relative;">
                    <ui:Button name="ViewButton" text="3D" class="view-button"/>
                    <ui:VisualElement name="ViewMenu" style="display: none; position: absolute; top: 80px; left: 16px; background-color: rgb(30, 34, 42); border-radius: 8px; flex-direction: column; min-width: 64px;">
                        <ui:Button text="3D" class="menu-option"/>
                        <ui:Button text="2D" class="menu-option"/>
                        <ui:Button text="Top" class="menu-option"/>
                        <ui:Button text="Side" class="menu-option"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="FullScreenButton" class="full-screen-button" style="background-image: url(&quot;project://database/Assets/UI/Icons/fullscreen.png?fileID=2800000&amp;guid=573a03db3500544a4a9653eed5db98df&amp;type=3#fullscreen&quot;);"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
