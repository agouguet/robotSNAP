/* ========================================
   Simulation.uss – Version stable (sans propriétés non supportées)
   ======================================== */

/* ===== BOUTONS D’ACTION ===== */
.action-button {
    flex-direction: row;
    align-items: center;
    background-color: var(--button-bg);
    border-radius: 8px;
    padding: 10px 18px;
    margin-left: 12px;
    border-width: 0;
    color: var(--text-primary);
    font-size: 14px;
}
.action-button:hover {
    background-color: var(--button-hover);
}

/* ===== SPLIT BUTTON ===== */
.split-button-container {
    flex-direction: row;
    margin-left: 12px;
    border-radius: 8px;
    overflow: hidden;
    background-color: var(--accent);
}
.split-button-primary {
    flex-direction: row;
    align-items: center;
    background-color: var(--accent);
    border-width: 0;
    padding: 10px 16px;
    color: white;
    margin: 0;
}
.split-button-primary Label {
    color: white;
}
.split-button-primary .button-icon {
    -unity-background-image-tint-color: white;
}
.split-button-primary:hover {
    background-color: var(--accent-soft);
}
.split-button-arrow {
    background-color: var(--accent);
    border-width: 0;
    border-left-width: 1px;
    border-left-style: solid;
    border-left-color: rgba(255,255,255,0.3);
    padding: 10px 12px;
    color: white;
    font-size: 12px;
    margin: 0;
}
.split-button-arrow:hover {
    background-color: var(--accent-soft);
}

