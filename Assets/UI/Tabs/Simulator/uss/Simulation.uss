#RightBar {
    width: 30%;
    min-height: 0;
}

#BottomBar {
    height: 20%;
}

/* Définition unique pour tous les boutons d'action */
.action-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;          /* centre l'icône + texte horizontalement */
    
    background-color: var(--accent);
    border-width: 0;
    border-radius: 8px;
    padding: 10px 8px;                /* padding intérieur (ajustez selon besoin) */
    margin: 0;                        /* on gérera les marges externes séparément */
    margin-left: 18px;
    
    color: white;
    font-size: 14px;
    
    width: 150px;                     /* largeur fixe pour tous */
    flex-shrink: 0;                  /* empêche le rétrécissement */
    flex-grow: 0;                    /* empêche l'étirement */
    min-width: 150px;                /* optionnel, pour forcer la largeur */
}

/* Couleur du texte et de l'icône en blanc */
.action-button Label {
    color: white;
}

.action-button .button-icon {
    -unity-background-image-tint-color: white;
    margin-right: 6px;               /* espace entre l'icône et le texte */
}

/* Hover */
.action-button:hover {
    background-color: var(--accent-soft);
}

.start-stop-button.running {
    background-color: var(--danger-color, #c0392b);
}
.start-stop-button.running:hover {
    background-color: var(--danger-hover, #e74c3c);
}


.simulation-bottom-tabs-panel {
    flex-direction: column;
    height: auto;
    min-height: 300px;
    max-height: 300px;
    background-color: var(--panel-bg);
    border-width: 1px;
    border-style: solid;
    border-color: var(--accent-glow);
    border-radius: 12px;
    transition: border-color 0.2s;
    margin: 8px;
    padding: 4px 8px;
}

.simulation-bottom-tabs-panel:hover {
    border-color: var(--accent-soft);
    background-color: var(--bg-secondary);
}

.tabs-toolbar {
    flex-direction: row;
    /* background-color: var(--panel-bg); */
}

.tab-content {
    flex-grow: 1;
    min-height: 0;
}

.tab-pane {
    overflow: auto;
    height: 100%;
}

.tab-button {
    background-color: transparent;
    border-width: 0;
    padding: 8px 16px;
    margin: 0;
    font-size: 12px;
    color: var(--text-secondary);
}

.tab-button.active {
    color: var(--accent-soft);
    background-color: var(--accent-glow);
}
