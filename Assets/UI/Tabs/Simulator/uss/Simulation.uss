#RightBar {
    width: 30%;
    min-height: 0;
}

#BottomBar {
    height: 20%;
}

.action-button {
    flex-direction: row;
    align-items: center;
    background-color: var(--button-bg);
    border-radius: 8px;
    padding: 10px 18px;
    margin-left: 12px;
    border-width: 0;
    color: var(--text-primary);
    font-size: 14px;
}

.action-button:hover {
    background-color: var(--button-hover);
}

.split-button-container {
    flex-direction: row;
    margin-left: 12px;
    border-radius: 8px;
    overflow: hidden;
    background-color: var(--accent);
}

.split-button-primary {
    flex-direction: row;
    align-items: center;
    background-color: var(--accent);
    border-width: 0;
    padding: 10px 16px;
    color: white;
    margin: 0;
}

.split-button-primary Label {
    color: white;
}

.split-button-primary .button-icon {
    -unity-background-image-tint-color: white;
}

.split-button-primary:hover {
    background-color: var(--accent-soft);
}

.split-button-arrow {
    background-color: var(--accent);
    border-width: 0;
    border-left-width: 1px;
    border-left-style: solid;
    border-left-color: rgba(255, 255, 255, 0.3);
    padding: 10px 12px;
    color: white;
    font-size: 12px;
    margin: 0;
}

.split-button-arrow:hover {
    background-color: var(--accent-soft);
}

.simulation-bottom-tabs-panel {
    flex-direction: column;
    height: auto;
    min-height: 300px;
    max-height: 300px;
    background-color: var(--panel-bg);
    border-width: 1px;
    border-style: solid;
    border-color: var(--accent-glow);
    border-radius: 12px;
    transition: border-color 0.2s;
    margin: 8px;
    padding: 4px 8px;
}

.simulation-bottom-tabs-panel:hover {
    border-color: var(--accent-soft);
    background-color: var(--bg-secondary);
}

.tabs-toolbar {
    flex-direction: row;
    /* background-color: var(--panel-bg); */
}

.tab-content {
    flex-grow: 1;
    min-height: 0;
}

.tab-pane {
    overflow: auto;
    height: 100%;
}

.tab-button {
    background-color: transparent;
    border-width: 0;
    padding: 8px 16px;
    margin: 0;
    font-size: 12px;
    color: var(--text-secondary);
}

.tab-button.active {
    color: var(--accent-soft);
    background-color: var(--accent-glow);
}


