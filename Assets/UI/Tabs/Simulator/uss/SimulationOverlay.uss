/* ---------------------------------------------------------------
   Simulation HUD
   The camera view fills the column; the agent panel is a sibling
   column on the right, the status strip closes the bottom edge.
   --------------------------------------------------------------- */

.simulation-overlay {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
}

.simulation-body {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

.viewport-column {
    flex-grow: 1;
    min-width: 0;
    position: relative;
}

.camera-container {
    flex-grow: 1;
    border-radius: 12px;
    overflow: hidden;
    background-color: var(--bg-secondary);
}

.camera-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

.camera-overlay.is-hidden {
    display: none;
}

.paused-badge {
    color: var(--text-primary);
    font-size: 28px;
    -unity-font-style: bold;
    background-color: var(--panel-bg);
    padding: 10px 22px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--border-color);
}

/* Every floating piece of the HUD lives in this layer. It ignores the
   mouse itself so the camera keeps receiving drags between the widgets. */
.overlay-layer {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.is-hidden {
    display: none;
}

/* --------------------------- search field ------------------------- */

.agent-search-row {
    flex-direction: row;
    align-items: center;
    height: 30px;
    padding-left: 8px;
    padding-right: 6px;
    margin-bottom: 6px;
    background-color: var(--button-bg);
    border-radius: 8px;
}

.search-glyph {
    color: var(--text-secondary-muted);
    font-size: 13px;
    margin-right: 6px;
}

.agent-search-field {
    flex-grow: 1;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--text-primary);
    font-size: 12px;
}

.agent-search-field .unity-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--text-primary);
    font-size: 12px;
    padding-left: 0;
    padding-right: 0;
}

/* --------------------------- view toolbar ------------------------- */

.view-toolbar {
    position: absolute;
    top: 68px;
    left: 14px;
    flex-direction: column;
    padding: 6px;
    background-color: var(--panel-bg);
    border-width: 1px;
    border-color: var(--border-color);
    border-radius: 12px;
}

.view-tool {
    width: 32px;
    height: 32px;
    margin: 2px;
    padding: 0;
    border-width: 0;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--text-secondary);
    font-size: 14px;
    -unity-text-align: middle-center;
}

.view-tool:hover {
    background-color: var(--button-bg);
    color: var(--text-primary);
}

.view-tool.is-active {
    background-color: var(--accent);
    color: rgb(255, 255, 255);
}

.view-tool-divider {
    height: 1px;
    margin: 6px 4px;
    background-color: var(--border-color);
}

/* ---------------------------- minimap ----------------------------- */

.minimap-panel {
    position: absolute;
    left: 14px;
    bottom: 14px;
    width: 252px;
    padding: 8px;
    background-color: var(--panel-bg);
    border-width: 1px;
    border-color: var(--border-color);
    border-radius: 12px;
}

.minimap-title {
    color: var(--text-secondary);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.6px;
    margin-bottom: 6px;
    margin-left: 2px;
}

.minimap-map {
    position: relative;
    width: 100%;
    height: 200px;
    background-color: rgb(12, 18, 30);
    border-radius: 8px;
    overflow: hidden;
}

.minimap-image {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* An occupancy grid is a black-and-white picture, so it is tinted into the palette of the app
   instead of flashing pure white inside a dark panel. The rendered top view keeps its own colours,
   which is why the tint only applies to the grid. */
.minimap-image.is-grid {
    -unity-background-image-tint-color: rgb(163, 184, 209);
}

.minimap-dots {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.minimap-dot {
    position: absolute;
    width: 11px;
    height: 11px;
    margin-left: -5.5px;
    margin-top: -5.5px;
    border-radius: 6px;
    background-color: var(--accent);
    border-width: 2px;
    border-color: rgba(15, 23, 42, 0.75);
}

.minimap-dot.human {
    background-color: rgb(245, 158, 11);
}

.minimap-dot.robot {
    background-color: rgb(37, 99, 235);
}

.minimap-dot.is-focused {
    width: 15px;
    height: 15px;
    margin-left: -7.5px;
    margin-top: -7.5px;
    border-radius: 8px;
    border-width: 3px;
    border-color: rgb(255, 255, 255);
}

/* --------------------------- agent panel -------------------------- */

.agent-panel {
    width: 344px;
    /* A definite width has to win over the min-content width of the rows inside it. */
    min-width: 0;
    flex-shrink: 0;
    flex-direction: row;
    margin-left: 12px;
    background-color: var(--panel-bg);
    border-width: 1px;
    border-color: var(--border-color);
    border-radius: 12px;
    overflow: hidden;
}

.agent-panel.is-collapsed {
    width: 40px;
}

.agent-panel.is-collapsed .agent-panel-content {
    display: none;
}

/* The rail holds the chevron and stays when every section is folded away. */
.agent-panel-rail {
    width: 40px;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    padding-top: 8px;
}

.agent-panel-collapse {
    width: 30px;
    height: 30px;
    padding: 0;
    border-width: 0;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--text-secondary);
    font-size: 16px;
    -unity-text-align: middle-center;
}

.agent-panel-collapse:hover {
    background-color: var(--button-bg);
    color: var(--text-primary);
}

.agent-panel-content {
    flex-grow: 1;
    padding: 10px 18px 16px 4px;
    min-width: 0;
}

/* Foldable sections: the header carries the chevron and the body folds away. Both sections of the
   panel share the pair, so they breathe and shrink the same way. */
.panel-section-header {
    height: 40px;
    padding-left: 0;
    padding-right: 0;
    margin-top: 4px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--text-primary);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    /* A long list heading must not push the panel wider than the column it lives in. */
    min-width: 0;
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    -unity-text-overflow-position: end;
}

.panel-section-header:hover {
    color: var(--accent-soft);
}

.panel-section-content {
    flex-direction: column;
    padding-bottom: 10px;
}

.panel-section-content.is-folded {
    display: none;
}

.selected-agent-card {
    flex-direction: row;
    align-items: center;
    padding: 12px;
    background-color: var(--card-bg);
    border-width: 1px;
    border-color: var(--border-color);
    border-radius: 10px;
    margin-bottom: 12px;
}

.selected-agent-icon {
    width: 40px;
    height: 40px;
    margin-right: 12px;
    border-radius: 9px;
    background-color: var(--accent-glow);
    background-size: contain;
}

.selected-agent-heading {
    flex-grow: 1;
}

.selected-agent-name {
    color: var(--text-primary);
    font-size: 17px;
    -unity-font-style: bold;
    min-width: 0;
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    -unity-text-overflow-position: end;
}

.selected-agent-badge {
    color: var(--accent);
    font-size: 12px;
    margin-top: 3px;
}

.agent-info {
    flex-direction: column;
}

.agent-info-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 26px;
}

.agent-info-label {
    color: var(--text-secondary);
    font-size: 13px;
}

.agent-info-value {
    color: var(--text-primary);
    font-size: 13px;
}

.agent-list {
    flex-direction: column;
}

.agent-row {
    flex-direction: row;
    align-items: center;
    height: 38px;
    padding-left: 8px;
    padding-right: 6px;
    margin-bottom: 3px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
}

.agent-row:hover {
    background-color: var(--button-bg);
}

.agent-row.is-selected {
    background-color: var(--accent-glow);
    border-color: var(--accent);
}

.agent-row-icon {
    width: 20px;
    height: 20px;
    margin-right: 9px;
    background-size: contain;
}

.agent-row-icon.human {
    background-color: rgba(245, 158, 11, 0.18);
    border-radius: 10px;
}

.agent-row-icon.robot {
    background-color: var(--accent-glow);
    border-radius: 10px;
}

.agent-row-name {
    flex-grow: 1;
    min-width: 0;
    color: var(--text-primary);
    font-size: 13px;
    overflow: hidden;
    white-space: nowrap;
    -unity-text-overflow-position: end;
}

.agent-row-detail {
    flex-shrink: 0;
    color: var(--text-secondary-muted);
    font-size: 12px;
    margin-right: 8px;
}

.agent-row-action {
    width: 26px;
    height: 26px;
    padding: 0;
    border-width: 0;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--text-secondary);
    font-size: 13px;
    -unity-text-align: middle-center;
}

.agent-row-action:hover {
    background-color: var(--accent-glow);
    color: var(--accent);
}
