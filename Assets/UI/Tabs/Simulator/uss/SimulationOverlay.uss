.simulation-overlay {
    padding: 8px;
    position: relative;
    margin: 8px;
    background-color: var(--panel-bg);
    border-width: 1px;
    border-style: solid;
    border-color: var(--accent-glow);
    border-radius: 12px;
    transition: border-color 0.2s;
}

.simulation-overlay:hover {
    border-color: var(--accent-soft);
    background-color: var(--bg-secondary);
}

.camera-overlay {
    background-color: rgba(0, 0, 0, 0.6);
    justify-content: center;
    align-items: center;
}

.full-screen-button {
    width: 64px;
    height: 64px;
    background-size: contain;
    background-color: var(--bg-secondary);
    -unity-background-image-tint-color: var(--icon-tint);
    border-radius: 8px;
    border-width: 0;
    right: 30px;
    bottom: 30px;
}

.view-dropdown-container {
    top: 32px;
    left: 32px;
    position: absolute; 
    pointer-events: auto;
}

.view-button {
    background-color: var(--button-bg);
    width: 64px;
    height: 64px;
    margin: 0;
    border-radius: 8px;
    color: var(--text-primary);
    font-size: 20px;
    border-width: 0;
}

.view-button.active {
    background-color: var(--accent);
    color: white;
}

.view-menu {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: 1px;
    background-color: var(--bg-secondary);
    border-radius: 8px;
    border-width: 1px;
    border-style: solid;
    border-color: var(--border-color);
    min-width: 64px;
    max-width: 64px;
    z-index: 10;
    flex-direction: column;
}

.menu-option {
    background-color: transparent;
    border-width: 0;
    padding: 8px 12px;
    color: var(--text-primary);
    font-size: 14px;
}

.menu-option:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

.menu-option.disabled-option {
    opacity: 0.4;
    pointer-events: none;
    background-color: var(--button-bg);
    color: var(--text-secondary);
}

.minimap-container {
    top: 32px;
    right: 32px;
    position: absolute; 
    pointer-events: auto;
    width: 256px;
    height: 256px;
    background-color: var(--panel-bg);
    border-radius: 12px;
    border-width: 4px;
    border-style: solid;
    border-color: var(--border-color);
    overflow: hidden;
}

.minimap-title {
    position: absolute;
    top: 4px;
    left: 8px;
    font-size: 10px;
    color: var(--text-secondary);
}

/* A full-width strip along the bottom of the camera view. It is the strip that
   centres the pill, so the pill stays centred whatever the width of its
   content; the strip itself is transparent to the mouse and only the pill
   takes the clicks. */
.agent-focus-container {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 24px;
    justify-content: center;
    align-items: center;
    pointer-events: none;
}

.agent-focus-bar {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 56px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: var(--panel-bg);
    border-radius: 28px;
    border-width: 1px;
    border-style: solid;
    border-color: var(--border-color);
    pointer-events: auto;
    transition: border-color 0.2s;
}

.agent-focus-bar:hover {
    border-color: var(--accent-soft);
}

/* Camera lock: filled while the camera follows an agent, muted when the bar
   only reports that nothing is focused yet. */
.focus-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: var(--accent);
    margin-right: 12px;
    flex-shrink: 0;
}

.focus-status-dot.idle {
    background-color: var(--text-secondary-muted);
    opacity: 0.5;
}

.focus-block {
    flex-direction: column;
    justify-content: center;
    height: 100%;
    margin-left: 12px;
    margin-right: 12px;
}

.block-label {
    font-size: 10px;
    letter-spacing: 0.6px;
    color: var(--text-secondary-muted);
    margin-bottom: 2px;
    align-self: flex-start;
    -unity-font-style: bold;
}

.block-value {
    font-size: 18px;
    color: var(--text-primary);
    align-self: flex-start;
    -unity-font-style: bold;
}

/* The agent name is the headline of the bar: it may be long, so it is capped
   and elided instead of stretching the pill off centre. */
.agent-name {
    max-width: 180px;
    white-space: nowrap;
    overflow: hidden;
    -unity-text-overflow-position: end;
}

.agent-progress {
    color: var(--accent);
}

.separator-vertical {
    width: 1px;
    height: 32px;
    background-color: var(--border-color);
    flex-shrink: 0;
}

.focus-controls {
    flex-direction: row;
    align-items: center;
}

.agent-nav-button {
    background-color: var(--button-bg);
    border-width: 0;
    border-radius: 15px;
    width: 30px;
    height: 30px;
    color: var(--text-secondary);
    font-size: 12px;
    padding: 0;
    margin: 0 4px;
}

.agent-nav-button:hover {
    background-color: var(--button-hover);
    color: var(--text-primary);
}

.agent-dropdown {
    background-color: var(--button-bg);
    border-radius: 15px;
    color: var(--text-primary);
    font-size: 13px;
    padding: 0 0;
    border-width: 0;
    min-width: 132px;
    max-width: 132px;
    height: 30px;
    margin: 0 2px;
}

.agent-dropdown:hover {
    background-color: var(--button-hover);
}

.agent-dropdown:disabled {
    opacity: 0.5;
}

.agent-dropdown .unity-base-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    height: 100%;
    padding: 0 0;
}

.agent-dropdown .unity-base-popup-field__arrow {
    display: none;
}

.agent-dropdown .unity-base-popup-field__text {
    height: 100%;
    min-width: 0;
    color: var(--text-primary);
    -unity-text-align: middle-center;
    -unity-text-overflow-position: end;
}

.agent-dropdown .unity-base-text-field__input {
    color: var(--text-primary);
    -unity-text-align: middle-center;
}

.agent-dropdown .unity-popup-field__arrow {
    color: var(--text-secondary);
}
