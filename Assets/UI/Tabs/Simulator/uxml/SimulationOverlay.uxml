<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Tabs/Simulator/uss/SimulationOverlay.uss?fileID=7433441132597879392&amp;guid=27c54c89d70da1b40a74fd39beaa1d66&amp;type=3#SimulationOverlay"/>
    <ui:VisualElement class="simulation-overlay" style="flex-grow: 1;">
        <ui:VisualElement name="CameraContainer" style="flex-grow: 1; border-radius: 16px; overflow: hidden;">
            <ui:VisualElement name="CameraOverlay" class="camera-overlay" style="display: none; position: absolute; top: 0; left: 0; right: 0; bottom: 0; justify-content: center; align-items: center; flex-grow: 1;">
                <ui:Label text="PAUSED" style="color: white; font-size: 32px; unity-font-style: bold; background-color: rgba(0, 0, 0, 0.7); padding: 12px 24px; border-radius: 8px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; pointer-events: none;">
            <ui:VisualElement name="ViewDropdownContainer" class="view-dropdown-container" style="position: absolute; pointer-events: auto;">
                <ui:Button name="ViewButton" text="3D" class="view-button"/>
                <ui:VisualElement name="ViewMenu" class="view-menu" style="display: none; flex-direction: column;"/>
            </ui:VisualElement>
            <ui:VisualElement name="MinimapContainer" class="minimap-container" style="position: absolute;">
                <ui:Label text="Minimap" class="minimap-title"/>
            </ui:VisualElement>
            <ui:Button name="FullScreenButton" class="full-screen-button" style="position: absolute; pointer-events: auto; background-image: url(&quot;project://database/Assets/Resources/Icons/fullscreen.png?fileID=2800000&amp;guid=573a03db3500544a4a9653eed5db98df&amp;type=3#fullscreen&quot;);"/>
            <ui:VisualElement name="AgentFocusBar" class="agent-focus-bar" style="position: absolute; pointer-events: auto;">
                <ui:VisualElement class="focus-block">
                    <ui:Label text="AGENT ID" class="block-label"/>
                    <ui:Label name="AgentNameLabel" text="TIAGO Base" class="block-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="separator-vertical"/>
                <ui:VisualElement class="focus-block">
                    <ui:Label text="PROGRESS" class="block-label"/>
                    <ui:Label name="AgentProgressLabel" text="78%" class="block-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="separator-vertical"/>
                <ui:VisualElement class="focus-block">
                    <ui:Label text="FOCUS" class="block-label"/>
                    <ui:VisualElement class="focus-controls">
                        <ui:Button name="PrevAgentButton" text="◀" class="agent-nav-button"/>
                        <ui:DropdownField name="AgentDropdown" label="" class="agent-dropdown" style="min-width: 120px;"/>
                        <ui:Button name="NextAgentButton" text="▶" class="agent-nav-button"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label text="Simulation" class="panel-title-corner"/>
    </ui:VisualElement>
</ui:UXML>
