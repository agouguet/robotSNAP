<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Tabs/Simulator/uss/SimulationOverlay.uss?fileID=7433441132597879392&amp;guid=27c54c89d70da1b40a74fd39beaa1d66&amp;type=3#SimulationOverlay"/>
    <ui:VisualElement class="simulation-overlay">
        <ui:VisualElement name="SimulationBody" class="simulation-body">
            <ui:VisualElement name="ViewportColumn" class="viewport-column">
                <ui:VisualElement name="CameraContainer" class="camera-container">
                    <ui:VisualElement name="CameraOverlay" class="camera-overlay is-hidden">
                        <ui:Label text="PAUSED" class="paused-badge"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="OverlayLayer" class="overlay-layer" picking-mode="Ignore">
                    <ui:VisualElement name="ViewToolbar" class="view-toolbar">
                        <ui:Button name="ToolSelectButton" text="➤" class="view-tool is-active"
                                   tooltip="Select: click an agent to work with it"/>
                        <ui:Button name="ToolMoveButton" text="✥" class="view-tool"
                                   tooltip="Move: left drag slides the view and releases the agent, right drag turns it, the wheel zooms it"/>

                        <!-- The three camera views share this rail instead of living in a selector of
                             their own: the rail is already what drives the view, and one column keeps
                             the hand in one place. They carry ASCII labels while the tools above get
                             drawn pictograms, because the default font has no dependable glyph for a
                             camera view and a missing one draws as an empty square - the tooltip
                             carries the long name. The divider is what reads the two groups apart. The
                             highlight is read back from the camera rather than from the click, so a
                             view the code picked (a run hands it back to the robot) lights up here
                             too. -->
                        <ui:VisualElement class="view-tool-divider"/>

                        <ui:Button name="ViewIsometricButton" text="ISO" class="view-tool view-mode is-active"
                                   tooltip="Isometric view: the angled overview of the map"/>
                        <ui:Button name="ViewFirstPersonButton" text="1P" class="view-tool view-mode"
                                   tooltip="First person view: look through the eyes of the selected agent"/>
                        <ui:Button name="ViewThirdPersonButton" text="3P" class="view-tool view-mode"
                                   tooltip="Third person view: follow the selected agent from behind"/>
                    </ui:VisualElement>

                    <ui:VisualElement name="MinimapPanel" class="minimap-panel">
                        <ui:Label name="MinimapTitle" text="Top view" class="minimap-title"/>
                        <ui:VisualElement name="MinimapMap" class="minimap-map">
                            <ui:Image name="MinimapImage" class="minimap-image"/>
                            <ui:VisualElement name="MinimapDots" class="minimap-dots" picking-mode="Ignore"/>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Debug switches for the shot, folded away by default: they are translucent and float
                         over the top right corner of the view, out of the way of the toolbar on the left and
                         of the minimap under it. -->
                    <ui:VisualElement name="VisualizationPanel" class="viz-panel">
                        <ui:VisualElement class="viz-panel-header">
                            <ui:Label text="Visualization" class="viz-panel-title"/>
                            <ui:Button name="VisualizationPanelCollapseButton" text="‹"
                                       class="viz-panel-collapse" tooltip="Collapse or expand this panel"/>
                        </ui:VisualElement>
                        <ui:ScrollView name="VisualizationPanelContent" class="viz-panel-content">
                            <ui:Label text="Robot" class="viz-group-title"/>
                            <ui:Toggle name="VizRobotTrajectory" label="Trajectory" class="viz-toggle"/>
                            <ui:Toggle name="VizRobotPath" label="Planned path" class="viz-toggle"/>
                            <ui:Toggle name="VizRobotGoal" label="Goal" class="viz-toggle"/>
                            <ui:Toggle name="VizRobotVelocity" label="Velocity" class="viz-toggle"/>
                            <ui:Toggle name="VizRobotLidar" label="Lidar rays" class="viz-toggle"/>

                            <ui:Label text="Crowd" class="viz-group-title"/>
                            <ui:Toggle name="VizHumanTrajectories" label="Trajectories" class="viz-toggle"/>
                            <ui:Toggle name="VizHumanGoals" label="Goals" class="viz-toggle"/>
                            <ui:Toggle name="VizHumanVelocity" label="Velocity" class="viz-toggle"/>
                            <ui:Toggle name="VizHumanInteraction" label="Interaction radius" class="viz-toggle"/>
                            <ui:Toggle name="VizHumanColors" label="Colour by state" class="viz-toggle"/>

                            <ui:Label text="Scene" class="viz-group-title"/>
                            <ui:Toggle name="VizGrid" label="Ground grid" class="viz-toggle"/>
                            <ui:Toggle name="VizAxes" label="World axes" class="viz-toggle"/>
                            <ui:Toggle name="VizWireframe" label="Wireframe" class="viz-toggle"/>
                            <ui:Toggle name="VizAgentLabels" label="Agent labels" class="viz-toggle"/>
                            <ui:Toggle name="VizDistances" label="Distances to robot" class="viz-toggle"/>

                            <ui:Label text="Minimap" class="viz-group-title"/>
                            <ui:Toggle name="VizDetectionFootprints" label="Detection footprints" class="viz-toggle"/>
                            <ui:Toggle name="VizMinimapLidarSweep" label="Robot lidar sweep" class="viz-toggle"/>
                        </ui:ScrollView>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="AgentPanel" class="agent-panel">
                <ui:VisualElement class="agent-panel-rail">
                    <ui:Button name="AgentPanelCollapseButton" text="›" class="agent-panel-collapse"
                               tooltip="Collapse or expand this panel"/>
                </ui:VisualElement>
                <ui:ScrollView name="AgentPanelContent" class="agent-panel-content">
                    <ui:Button name="SelectedAgentSectionHeader" text="Selected Agent" class="panel-section-header"/>
                    <ui:VisualElement name="SelectedAgentSectionContent" class="panel-section-content">
                        <ui:VisualElement name="SelectedAgentCard" class="selected-agent-card">
                            <ui:VisualElement name="SelectedAgentIcon" class="selected-agent-icon"/>
                            <ui:VisualElement class="selected-agent-heading">
                                <ui:Label name="SelectedAgentName" text="No agent" class="selected-agent-name"/>
                                <ui:Label name="SelectedAgentBadge" text="Nothing selected" class="selected-agent-badge"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="SelectedAgentInfo" class="agent-info"/>
                    </ui:VisualElement>

                    <ui:Button name="AgentListSectionHeader" text="Agents List" class="panel-section-header"/>
                    <ui:VisualElement name="AgentListSectionContent" class="panel-section-content">
                        <ui:VisualElement class="agent-search-row">
                            <ui:Label text="⌕" class="search-glyph"/>
                            <ui:TextField name="AgentListSearch" placeholder="Search agent..." class="agent-search-field"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="AgentList" class="agent-list"/>
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
