<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Tabs/Simulator/uss/SimulationOverlay.uss?fileID=7433441132597879392&amp;guid=27c54c89d70da1b40a74fd39beaa1d66&amp;type=3#SimulationOverlay"/>
    <ui:VisualElement class="simulation-overlay">
        <ui:VisualElement name="SimulationBody" class="simulation-body">
            <ui:VisualElement name="ViewportColumn" class="viewport-column">
                <ui:VisualElement name="CameraContainer" class="camera-container">
                    <ui:VisualElement name="CameraOverlay" class="camera-overlay is-hidden">
                        <ui:Label text="PAUSED" class="paused-badge"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="OverlayLayer" class="overlay-layer" picking-mode="Ignore">
                    <ui:VisualElement name="ViewToolbar" class="view-toolbar">
                        <ui:Button name="ToolSelectButton" text="➤" class="view-tool is-active"
                                   tooltip="Select: click an agent to work with it"/>
                        <ui:Button name="ToolMoveButton" text="✥" class="view-tool"
                                   tooltip="Move: left drag slides the view and releases the agent, right drag turns it, the wheel zooms it"/>
                        <ui:Button name="ToolRotateButton" text="↻" class="view-tool"
                                   tooltip="Rotate: drag to turn around the scene"/>
                        <ui:Button name="ToolZoomButton" text="⌕" class="view-tool"
                                   tooltip="Zoom: drag up and down, or use the wheel"/>
                    </ui:VisualElement>

                    <!-- The view selector mirrors the toolbar on the other side of the shot. Its three
                         names are the three views of the camera; the highlight follows the camera, so a
                         view the code picked (a run hands it back to the robot) lights up here too. -->
                    <ui:VisualElement name="ViewModeSelector" class="view-modes">
                        <ui:Button name="ViewIsometricButton" text="Isometric" class="view-tool view-mode is-active"
                                   tooltip="Isometric: the angled view over the map"/>
                        <ui:Button name="ViewFirstPersonButton" text="First person" class="view-tool view-mode"
                                   tooltip="First person: look through the eyes of the selected agent"/>
                        <ui:Button name="ViewThirdPersonButton" text="Third person" class="view-tool view-mode"
                                   tooltip="Third person: follow the selected agent from behind"/>
                    </ui:VisualElement>

                    <ui:VisualElement name="MinimapPanel" class="minimap-panel">
                        <ui:Label name="MinimapTitle" text="Top view" class="minimap-title"/>
                        <ui:VisualElement name="MinimapMap" class="minimap-map">
                            <ui:Image name="MinimapImage" class="minimap-image"/>
                            <ui:VisualElement name="MinimapDots" class="minimap-dots" picking-mode="Ignore"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="AgentPanel" class="agent-panel">
                <ui:VisualElement class="agent-panel-rail">
                    <ui:Button name="AgentPanelCollapseButton" text="›" class="agent-panel-collapse"
                               tooltip="Collapse or expand this panel"/>
                </ui:VisualElement>
                <ui:ScrollView name="AgentPanelContent" class="agent-panel-content">
                    <ui:Button name="SelectedAgentSectionHeader" text="Selected Agent" class="panel-section-header"/>
                    <ui:VisualElement name="SelectedAgentSectionContent" class="panel-section-content">
                        <ui:VisualElement name="SelectedAgentCard" class="selected-agent-card">
                            <ui:VisualElement name="SelectedAgentIcon" class="selected-agent-icon"/>
                            <ui:VisualElement class="selected-agent-heading">
                                <ui:Label name="SelectedAgentName" text="No agent" class="selected-agent-name"/>
                                <ui:Label name="SelectedAgentBadge" text="Nothing selected" class="selected-agent-badge"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="SelectedAgentInfo" class="agent-info"/>
                    </ui:VisualElement>

                    <ui:Button name="AgentListSectionHeader" text="Agents List" class="panel-section-header"/>
                    <ui:VisualElement name="AgentListSectionContent" class="panel-section-content">
                        <ui:VisualElement class="agent-search-row">
                            <ui:Label text="⌕" class="search-glyph"/>
                            <ui:TextField name="AgentListSearch" placeholder="Search agent..." class="agent-search-field"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="AgentList" class="agent-list"/>
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
